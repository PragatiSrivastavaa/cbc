<?php

use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\Core\Url;
use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_help().
 */
function password_encrypt_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    case 'help.page.password_encrypt':
      $output = '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('This module encrypts the user password on user form submission.
        It prevents the propagation of plain password over internet on user form submission.') . '</p>';
      $output .= '<h3>' . t('Dependencies:') . '</h3>';
      $output .= '<ol><li>' . t('OpenSSL extension.') . '</li>';
      $output .= '<li>' . t('CryptoJS library.') . '</li></ol>';
      $output .= '<h3>' . t('Installation:') . '</h3>';
      $output .= '<ol><li>' . t('Download CryptoJS library from %crypto and extract it. Move rollups/aes.js to %path.', [
        '%crypto' => Url::fromRoute('https://code.google.com/archive/p/crypto-js/downloads'),
        '%path' => 'sites/all/libraries/CryptoJS',
      ]) . '</li>';
      $output .= '<li>' . t('Install and Enable Password Encrypt module.') . '</li>';
      $output .= '<li>Clear cache.</li></ol>';

      return $output;
  }
}


/**
 * Get the global passkey.
 * 
 * We use a persistent state key to ensure reliability across cached pages 
 * and varying session states (e.g. anonymous vs authenticated).
 */
function encryptSaltKey() {
  $passkey = \Drupal::state()->get('password_encrypt.passkey');
  if (empty($passkey)) {
     // Generate one if missing (e.g. first run/install issue)
     $passkey = bin2hex(openssl_random_pseudo_bytes(8));
     \Drupal::state()->set('password_encrypt.passkey', $passkey);
  }
  return $passkey;
}



/**
 * Verifies CryptoJS library is present.
 */
function password_encrypt_library_check() {
  if (function_exists('libraries_get_libraries')) {
    $library = libraries_get_libraries();
    if (isset($library['CryptoJS'])) {
      $password_encrypt_library_installed = TRUE;
    }
  }
  elseif (file_exists('libraries/CryptoJS/aes.js')) {
    $password_encrypt_library_installed = TRUE;
  }
  else {
    $password_encrypt_library_installed = FALSE;
  }

  return $password_encrypt_library_installed;
}

/**
 * Implements hook_form_alter().
 */
function password_encrypt_form_alter(&$form, FormStateInterface &$form_state, $form_id) {
  if ($form_id == 'user_login_form' || $form_id == 'user_login_block' || $form_id == 'user_register_form' || $form_id == 'user_form') {
    // Add validation handler to decrypt password.
    array_unshift($form['#validate'], 'password_encrypt_user_decrypt_password');
    
    // Attach library and passkey here instead of on every page.
    $password_encrypt_passkey = encryptSaltKey();
    $form['#attached']['drupalSettings']['password_encrypt']['passkey'] = $password_encrypt_passkey;
    $form['#attached']['library'][] = 'password_encrypt/password_encrypt';
    
    // Disable caching for these forms to ensure unique passkey per session/request if needed
    // (Though session start usually handles this, explicit kill is safer for login blocks)
    $form['#cache']['max-age'] = 0;
  }
}


/**
 * Callback: called to decrypt user password.
 *
 * Adds debug logging and messages when decryption fails.
 */
function password_encrypt_user_decrypt_password(&$form, FormStateInterface $form_state) {
  // Use the consistent global key.
  $password_encrypt_passkey = encryptSaltKey();

  // Decrypt 'pass' if present.
  if ($form_state->hasValue('pass')) {
    $pass_value = $form_state->getValue('pass');

    if (is_array($pass_value)) {
      // Handle password_confirm elements (array with pass1 and pass2).
      $decrypted_any = FALSE;
      $decryption_error = FALSE;
      
      // We only strictly need to decrypt pass1 for the value, but validation checks both matching.
      // If JS set both to same cipher, decrypting one is enough, but loop handles both.
      foreach ($pass_value as $key => $encrypted) {
        if (empty($encrypted)) continue;
        
        $decrypted = password_encrypt_crypto_js_aes_decrypt($password_encrypt_passkey, $encrypted);
        
        // Strict check: if decrypt returns FALSE or NULL, it failed.
        // Also check if result still looks like ciphertext (Salted__) which means decryption logic didn't trigger but it should have.
        if ($decrypted === FALSE || $decrypted === NULL) {
           $decryption_error = TRUE;
        } elseif (substr($decrypted, 0, 8) === 'Salted__') {
           // It didn't decrypt (maybe wrong key), just returned original.
           $decryption_error = TRUE;
        } else {
           $pass_value[$key] = $decrypted;
           $decrypted_any = TRUE;
        }
      }

      if ($decryption_error) {
        \Drupal::logger('password_encrypt')->error('Password decryption failed for array elements.');
        $form_state->setErrorByName('pass', t('Secure password transmission failed. Please refresh the page and try again.'));
        $form_state->setValue('pass', []); // Clear it
      }
      elseif ($decrypted_any) {
        // Flatten the array to a single string for the entity save.
        // The Password items field expects a string value.
        // We know pass1 matches pass2 because that validation happens BEFORE this validator.
        $plain_pass = $pass_value['pass1'];
        $form_state->setValue('pass', $plain_pass);
        \Drupal::logger('password_encrypt')->debug('Password array decrypted. Flattening to string for save. Len: @len', ['@len' => strlen($plain_pass)]);
      }
    }
    else {
      // Handle single string password field (e.g. login form).
      $encrypted = $pass_value;
      if (!empty($encrypted)) {
          $decrypted_pass = password_encrypt_crypto_js_aes_decrypt($password_encrypt_passkey, $encrypted);
    
          if ($decrypted_pass === FALSE || $decrypted_pass === NULL || substr($decrypted_pass, 0, 8) === 'Salted__') {
            \Drupal::logger('password_encrypt')->error('Password decryption failed for login. Cipher length: @len', ['@len' => strlen((string) $encrypted)]);
            $form_state->setErrorByName('name', t('Secure login failed (decryption error). Please refresh and try again.')); 
            // We set error on 'name' usually for login forms to avoid revealing which part failed, but 'pass' is fine too.
          }
          else {
            $form_state->setValue('pass', $decrypted_pass);
          }
      }
    }
  }

  // Decrypt 'current_pass' if present (e.g. password change form).
  if ($form_state->hasValue('current_pass')) {
    $encrypted = $form_state->getValue('current_pass');
    if (!empty($encrypted)) {
        $decrypted_pass = password_encrypt_crypto_js_aes_decrypt($password_encrypt_passkey, $encrypted);
    
        if ($decrypted_pass === FALSE || $decrypted_pass === NULL || substr($decrypted_pass, 0, 8) === 'Salted__') {
          \Drupal::logger('password_encrypt')->error('Current password decryption failed.');
          $form_state->setErrorByName('current_pass', t('Current password validation failed during secure transmission. Please refresh.'));
        }
        else {
          $form_state->setValue('current_pass', $decrypted_pass);
        }
    }
  }
}

/**
 * Helper function for CryptoJS AES encryption/decryption.
 *
 * @param string $passphrase
 *   Passkey for encryption/decryption.
 * @param string $jsonstring
 *   Encoded string (base64).
 *
 * @return string|false
 *   Decoded string or FALSE on failure.
 */
function password_encrypt_crypto_js_aes_decrypt($passphrase, $jsonstring) {
  if (empty($jsonstring) || !is_string($jsonstring)) {
    return $jsonstring;
  }

  if (empty($passphrase)) {
    \Drupal::logger('password_encrypt')->warning('Decrypt called with empty passphrase.');
    return $jsonstring;
  }

  $cipher_text = base64_decode($jsonstring, TRUE);
  if ($cipher_text === FALSE) {
    // Not valid base64, so definitely not a CryptoJS Salted string.
    return $jsonstring;
  }

  if (substr($cipher_text, 0, 8) !== "Salted__") {
    // If it's not encrypted with Salted__ prefix, it might be plain text.
    // Return the original string to allow plain text fallback.
    return $jsonstring;
  }

  $salt = substr($cipher_text, 8, 8);
  $key_and_iv = password_encrypt_generate_iv($passphrase, $salt);
  $decrypt = openssl_decrypt(substr($cipher_text, 16), "aes-256-cbc", $key_and_iv["key"], OPENSSL_RAW_DATA, $key_and_iv["iv"]);
  if ($decrypt === FALSE || $decrypt === NULL) {
    \Drupal::logger('password_encrypt')->error('openssl_decrypt failed. Passphrase: @pass, Salt: @salt', [
      '@pass' => $passphrase,
      '@salt' => bin2hex($salt),
    ]);
    return FALSE;
  }

  return $decrypt;
}

/**
 * Generate key and iv used for decryption.
 */
function password_encrypt_generate_iv($password, $salt, $key_size = 8, $iv_length = 4, $iterations = 1, $algorithm = "md5") {
  $target_key_size = $key_size + $iv_length;
  $derived_bytes = "";
  $number_derived_words = 0;
  $block = NULL;
  $hasher = hash_init($algorithm);

  while ($number_derived_words < $target_key_size) {
    if ($block != NULL) {
      hash_update($hasher, $block);
    }

    hash_update($hasher, $password);
    hash_update($hasher, $salt);
    $block = hash_final($hasher, TRUE);
    $hasher = hash_init($algorithm);

    // Iterations.
    for ($i = 1; $i < $iterations; $i++) {
      hash_update($hasher, $block);
      $block = hash_final($hasher, TRUE);
      $hasher = hash_init($algorithm);
    }

    $derived_bytes .= substr($block, 0, min(strlen($block), ($target_key_size - $number_derived_words) * 4));
    $number_derived_words += strlen($block) / 4;
  }

  return [
    "key" => substr($derived_bytes, 0, $key_size * 4),
    "iv"  => substr($derived_bytes, $key_size * 4, $iv_length * 4),
  ];
}
