<?php

use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\Core\Url;
use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_help().
 */
function password_encrypt_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    case 'help.page.password_encrypt':
      $output = '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('This module protects user passwords using SHA-512 formatted encryption, fully compatible with Password Policies.') . '</p>';
      return $output;
  }
}

/**
 * Get the session-based encryption token (64 hex chars).
 */
function encryptSaltKey() {
  $session = \Drupal::service('session');
  if (!$session->isStarted()) {
    $session->start();
  }
  $passkey = $session->get('password_encrypt.token');
  if (empty($passkey)) {
     // Generate 32 bytes (64 hex) for AES-256.
     $passkey = bin2hex(openssl_random_pseudo_bytes(32));
     $session->set('password_encrypt.token', $passkey);
  }
  return $passkey;
}

/**
 * Implements hook_form_alter().
 */
function password_encrypt_form_alter(&$form, FormStateInterface &$form_state, $form_id) {
  if (in_array($form_id, ['user_login_form', 'user_login_block', 'user_register_form', 'user_form'])) {
    
    // 1. Add decryption handler at the VERY START.
    // This allows the native Password Policy module to run on the plain text.
    array_unshift($form['#validate'], 'password_encrypt_user_decrypt_password');
    
    // 2. Attach library and session token.
    $form['#attached']['library'][] = 'password_encrypt/password_encrypt';
    $form['#attributes']['data-pe-t'] = encryptSaltKey();
    
    // 3. Disable cache.
    $form['#cache']['max-age'] = 0;
  }
}

/**
 * Callback to decrypt before native policies run.
 */
function password_encrypt_user_decrypt_password(&$form, FormStateInterface $form_state) {
  $token = encryptSaltKey();

  if ($form_state->hasValue('pass')) {
    $pass_value = $form_state->getValue('pass');
    if (is_array($pass_value)) {
      foreach ($pass_value as $key => $val) {
        if (!empty($val)) {
           $decrypted = password_encrypt_decrypt_lookalike($val, $token);
           if ($decrypted) $pass_value[$key] = $decrypted;
        }
      }
      $form_state->setValue('pass', $pass_value);
    } else {
      $decrypted = password_encrypt_decrypt_lookalike($pass_value, $token);
      if ($decrypted) $form_state->setValue('pass', $decrypted);
    }
  }

  if ($form_state->hasValue('current_pass')) {
    $decrypted = password_encrypt_decrypt_lookalike($form_state->getValue('current_pass'), $token);
    if ($decrypted) $form_state->setValue('current_pass', $decrypted);
  }
}

/**
 * Decrypts 128-char hex (SHA lookalike) back to plain text.
 */
function password_encrypt_decrypt_lookalike($payload, $token) {
  if (!is_string($payload) || !ctype_xdigit($payload) || strlen($payload) < 64) {
    return FALSE;
  }
  
  try {
    $key = hex2bin($token); // 32 bytes
    $iv = hex2bin(substr($payload, 0, 32)); // 16 bytes IV from start of payload
    $data = hex2bin(substr($payload, 32));
    
    return openssl_decrypt($data, 'aes-256-cbc', $key, OPENSSL_RAW_DATA, $iv);
  } catch (\Exception $e) {
    return FALSE;
  }
}

function password_encrypt_library_check() {
  return file_exists('libraries/CryptoJS/aes.js');
}
