<?php

use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\Core\Url;
use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_help().
 */
function password_encrypt_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    case 'help.page.password_encrypt':
      $output = '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('This module encrypts the user password on user form submission using AES-256 (Hex format).
        It prevents the propagation of plain password over internet and works with standard Password Policies.') . '</p>';
      return $output;
  }
}

/**
 * Get the session-based encryption token.
 */
function encryptSaltKey() {
  $session = \Drupal::service('session');
  if (!$session->isStarted()) {
    $session->start();
  }
  $passkey = $session->get('password_encrypt.token');
  if (empty($passkey)) {
     $passkey = bin2hex(openssl_random_pseudo_bytes(16));
     $session->set('password_encrypt.token', $passkey);
  }
  return $passkey;
}

/**
 * Implements hook_form_alter().
 */
function password_encrypt_form_alter(&$form, FormStateInterface &$form_state, $form_id) {
  if (in_array($form_id, ['user_login_form', 'user_login_block', 'user_register_form', 'user_form'])) {
    
    // 1. Add our decryption validator at the VERY BEGINNING.
    // This ensures Password Policy sees the DECRYPTED password.
    array_unshift($form['#validate'], 'password_encrypt_user_decrypt_password');
    
    // 2. Attach library and session token.
    $form['#attached']['library'][] = 'password_encrypt/password_encrypt';
    $form['#attributes']['data-pe-t'] = encryptSaltKey();
    
    // 3. Disable cache.
    $form['#cache']['max-age'] = 0;
  }
}

/**
 * Callback: called to decrypt user password BEFORE other validators run.
 */
function password_encrypt_user_decrypt_password(&$form, FormStateInterface $form_state) {
  $password_encrypt_passkey = encryptSaltKey();

  // Decrypt 'pass'
  if ($form_state->hasValue('pass')) {
    $pass_value = $form_state->getValue('pass');
    if (is_array($pass_value)) {
      foreach ($pass_value as $key => $encrypted) {
        if (empty($encrypted)) continue;
        $decrypted = password_encrypt_crypto_js_aes_decrypt($password_encrypt_passkey, $encrypted);
        if ($decrypted !== FALSE && $decrypted !== NULL) {
          $pass_value[$key] = $decrypted;
        }
      }
      $form_state->setValue('pass', $pass_value);
    } else {
      $decrypted = password_encrypt_crypto_js_aes_decrypt($password_encrypt_passkey, $pass_value);
      if ($decrypted !== FALSE && $decrypted !== NULL) {
        $form_state->setValue('pass', $decrypted);
      }
    }
  }

  // Decrypt 'current_pass'
  if ($form_state->hasValue('current_pass')) {
    $encrypted = $form_state->getValue('current_pass');
    $decrypted = password_encrypt_crypto_js_aes_decrypt($password_encrypt_passkey, $encrypted);
    if ($decrypted !== FALSE && $decrypted !== NULL) {
      $form_state->setValue('current_pass', $decrypted);
    }
  }
}

/**
 * Decrypt function that handles both HEX and Base64.
 */
function password_encrypt_crypto_js_aes_decrypt($passphrase, $jsonstring) {
  if (empty($jsonstring) || !is_string($jsonstring)) return $jsonstring;
  
  // Try HEX first
  if (ctype_xdigit($jsonstring) && strlen($jsonstring) % 2 === 0) {
    $cipher_text = hex2bin($jsonstring);
  } else {
    $cipher_text = base64_decode($jsonstring, TRUE);
  }

  if ($cipher_text === FALSE || substr($cipher_text, 0, 8) !== "Salted__") {
    return $jsonstring; // Return original if not encrypted
  }

  $salt = substr($cipher_text, 8, 8);
  $key_and_iv = password_encrypt_generate_iv($passphrase, $salt);
  return openssl_decrypt(substr($cipher_text, 16), "aes-256-cbc", $key_and_iv["key"], OPENSSL_RAW_DATA, $key_and_iv["iv"]);
}

/**
 * Generate key and iv used for decryption.
 */
function password_encrypt_generate_iv($password, $salt, $key_size = 8, $iv_length = 4, $iterations = 1, $algorithm = "md5") {
  $target_key_size = $key_size + $iv_length;
  $derived_bytes = "";
  $number_derived_words = 0;
  $block = NULL;
  $hasher = hash_init($algorithm);
  while ($number_derived_words < $target_key_size) {
    if ($block != NULL) hash_update($hasher, $block);
    hash_update($hasher, $password);
    hash_update($hasher, $salt);
    $block = hash_final($hasher, TRUE);
    $hasher = hash_init($algorithm);
    for ($i = 1; $i < $iterations; $i++) {
      hash_update($hasher, $block);
      $block = hash_final($hasher, TRUE);
      $hasher = hash_init($algorithm);
    }
    $derived_bytes .= substr($block, 0, min(strlen($block), ($target_key_size - $number_derived_words) * 4));
    $number_derived_words += strlen($block) / 4;
  }
  return [
    "key" => substr($derived_bytes, 0, $key_size * 4),
    "iv"  => substr($derived_bytes, $key_size * 4, $iv_length * 4),
  ];
}

function password_encrypt_library_check() {
  return file_exists('libraries/CryptoJS/aes.js');
}
