<?php

/**
 * @file
 * Security validations for CBC.
 */

use Drupal\file\FileInterface;
use Drupal\Core\Form\FormStateInterface;

/**
 * Implements hook_file_validate().
 */
function cbc_security_file_validate(FileInterface $file) {
  $errors = [];
  $filename = $file->getFilename();
  $extension = strtolower(pathinfo($filename, PATHINFO_EXTENSION));
  $mime = $file->getMimeType();
  
  $log_path = \Drupal::service('file_system')->realpath('public://') . '/cbc_security_debug.log';
  file_put_contents($log_path, date('Y-m-d H:i:s') . " - Validating: $filename, Ext: $extension, MIME: $mime\n", FILE_APPEND);

  // Allowed Map
  $allowed_map = [
    'image/jpeg' => ['jpg', 'jpeg'],
    'image/png' => ['png'],
    'image/gif' => ['gif'],
    'image/webp' => ['webp'],
    'image/avif' => ['avif'],
    'application/pdf' => ['pdf'],
    'application/x-pdf' => ['pdf'],
    'video/mp4' => ['mp4', 'm4v'],
    'video/mpeg' => ['mpg', 'mpeg'],
    'video/quicktime' => ['mov'],
    'video/x-msvideo' => ['avi'],
    'audio/mpeg' => ['mp3'],
    'audio/wav' => ['wav'],
    'audio/x-wav' => ['wav'],
    'audio/ogg' => ['ogg'],
    'audio/mp4' => ['m4a', 'mp4'],
    'application/msword' => ['doc'],
    'application/vnd.openxmlformats-officedocument.wordprocessingml.document' => ['docx'],
    'application/vnd.ms-excel' => ['xls'],
    'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' => ['xlsx'],
    'application/zip' => ['docx', 'xlsx', 'pptx', 'zip'],
    'text/plain' => ['txt', 'csv'],
    'application/octet-stream' => ['pdf', 'mp4', 'avi', 'mov', 'mpg', 'mpeg', 'wav', 'mp3', 'm4a', 'docx', 'xlsx'],
  ];

  // Permissive check for common media/doc extensions
  $safe_extensions = ['pdf', 'mp4', 'mov', 'avi', 'mpg', 'mpeg', 'wav', 'mp3', 'm4a', 'docx', 'xlsx', 'jpg', 'jpeg', 'png', 'webp', 'avif'];
  
  if (in_array($extension, $safe_extensions)) {
      file_put_contents($log_path, date('Y-m-d H:i:s') . " - $filename allowed (Safe Extension)\n", FILE_APPEND);
      return [];
  }

  if (!isset($allowed_map[$mime]) || !in_array($extension, $allowed_map[$mime])) {
      // Last resort: if it's not in the map, block it unless it's an image we can verify
      if (strpos($mime, 'image/') === 0) {
          $realpath = \Drupal::service('file_system')->realpath($file->getFileUri());
          if ($realpath && @getimagesize($realpath)) {
              return [];
          }
      }
      
      $errors[] = t('The file %filename (type %type) is not allowed.', ['%filename' => $filename, '%type' => $mime]);
      file_put_contents($log_path, date('Y-m-d H:i:s') . " - $filename BLOCKED: $mime / $extension\n", FILE_APPEND);
  }

  return $errors;
}

/**
 * Implements hook_form_alter().
 */
function cbc_security_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  // SKIP ALL custom validation for webforms and SecKit.
  if (strpos($form_id, 'webform_') === 0 || strpos($form_id, 'seckit_') === 0) {
    return;
  }

  // Apply alpha validation to all textfields and textareas in the form.
  _cbc_security_apply_global_validation($form);
}

/**
 * Implements hook_field_widget_WIDGET_TYPE_form_alter().
 */
function cbc_security_field_widget_paragraphs_form_alter(&$element, FormStateInterface $form_state, $context) {
  $form_id = $form_state->getBuildInfo()['form_id'] ?? '';
  if (strpos($form_id, 'webform_') === 0 || strpos($form_id, 'seckit_') === 0) {
    return;
  }
  _cbc_security_apply_global_validation($element);
}

/**
 * Helper function to recursively apply validation.
 */
function _cbc_security_apply_global_validation(&$elements) {
  foreach (\Drupal\Core\Render\Element::children($elements) as $key) {
    if (isset($elements[$key]['#type'])) {
      $element_title = isset($elements[$key]['#title']) ? (string) $elements[$key]['#title'] : '';
      $exclude_patterns = '/url|path|alias|link|href|mail|contact|phone|mobile|number|token|file|media|captcha|src/i';
      $is_excluded = preg_match($exclude_patterns, (string)$key) || preg_match($exclude_patterns, $element_title);
      
      if (in_array($elements[$key]['#type'], ['textfield', 'textarea', 'email', 'tel'])) {
        if (!$is_excluded) {
          $elements[$key]['#element_validate'][] = 'cbc_security_validate_alpha_only';
        }
        else {
          $elements[$key]['#element_validate'][] = 'cbc_security_validate_no_html';
        }
      }
    }
    _cbc_security_apply_global_validation($elements[$key]);
  }
}

/**
 * Validator: Letters, spaces, slashes, hyphens, dots, commas, and underscores.
 */
/**
 * Validator: Letters, spaces, slashes, hyphens, dots, commas, underscores, and brackets.
 */
function cbc_security_validate_alpha_only(&$element, FormStateInterface $form_state) {
  $value = $element['#value'];

  if (!empty($value) && is_string($value)) {
    // Allow letters, spaces, / - ( ) [ ] , . _
    if (preg_match('/[^a-zA-Z\s\/\-\(\)\[\]\,\.\_]/', $value)) {
      $form_state->setError(
        $element,
        t(
          'The %field field can only contain letters, spaces, slashes (/), hyphens (-), brackets (), square brackets [], commas (,), dots (.), and underscores (_).',
          ['%field' => $element['#title'] ?? $element['#name']]
        )
      );
    }
  }
}


/**
 * Validator: No HTML tags.
 */
function cbc_security_validate_no_html(&$element, FormStateInterface $form_state) {
  $value = $element['#value'];
  if (!empty($value) && is_string($value)) {
    if (preg_match('/<[^>]*>/', $value)) {
      $form_state->setError($element, t('The %field field cannot contain HTML tags.', ['%field' => $element['#title'] ?? $element['#name']]));
    }
  }
}
