<section class="stats-section">

  <div class="stat">
    <h2 class="count" data-target="{{ data.users }}">{{ data.users }}</h2>
    <p>Users Onboarded on iGOT</p>
  </div>

  <div class="stat">
    <h2 class="count" data-target="{{ data.active }}">{{ data.active }}</h2>
    <p>Monthly Active Users</p>
  </div>

  <div class="stat">
    <h2 class="count" data-target="{{ data.certificates }}">{{ data.certificates }}</h2>
    <p>Certificate Issued Yesterday</p>
  </div>

  <div class="stat">
    <h2 class="count" data-target="{{ data.completions }}">{{ data.completions }}</h2>
    <p>Total Completions</p>
  </div>

  <div class="stat">
    <h2 class="count" data-target="{{ data.courses }}">{{ data.courses }}</h2>
    <p>Total Courses</p>
  </div>

</section>
