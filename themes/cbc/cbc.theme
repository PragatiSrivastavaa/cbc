/**
 * Implements hook_preprocess_menu().
 */
function cbc_preprocess_menu(&$variables) {
  $variables['base_path'] = base_path();
  // Also provide 'directory' variable which is common in theme templates
  // but missing in menu ones.
  $variables['directory'] = \Drupal::theme()->getActiveTheme()->getPath();
}

/**
 * Implements hook_preprocess_image_widget().
 */
function cbc_preprocess_image_widget(array &$variables) {
  $data = &$variables['data'];

  // This prevents image widget templates from rendering preview container HTML
  // to users that do not have permission to access these previews.
  // @todo revisit in https://drupal.org/node/953034
  // @todo revisit in https://drupal.org/node/3114318
  if (isset($data['preview']['#access']) && $data['preview']['#access'] === FALSE) {
    unset($data['preview']);
  }
}

// Implements hook_preprocess_page().

function cbc_preprocess_page(&$variables) {
  $language = \Drupal::languageManager()->getCurrentLanguage()->getId();
  $vars['language'] = $language;

  if (!empty($_SESSION['saltval']) && !empty($_SESSION['matchval']) && ($_SESSION['saltval'] == $_SESSION['matchval'])) {
    $variables['randval'] = $_SESSION['saltval'];
    $_SESSION['matchval'] = $variables['randval'];
  } else {
    $_SESSION['saltval'] = random_string();
    $_SESSION['matchval'] = $_SESSION['saltval'];
    $variables['randval'] = $_SESSION['saltval'];
  }
  $variables['#cache']['max-age'] = 0;
  global $base_url;
  $language = \Drupal::languageManager()->getCurrentLanguage()->getId();
  $vars['language'] = $language;

// for total visit count
  if (\Drupal::moduleHandler()->moduleExists('counter')) {
    /** @var \Drupal\counter\CounterUtility $counter_utility */
    $counter_utility = \Drupal::service('counter.counter_utility');

    // Total visitors.
    $total_visitors = $counter_utility->getVisitorData();

    // Unique visitors.
    $unique_visitors = $counter_utility->getUniqueVisitorData();

    // Pass variables to Twig.
    $variables['total_visitors'] = $total_visitors;
    $variables['unique_visitors'] = $unique_visitors;
  }


  if ($node = \Drupal::routeMatch()->getParameter('node')) {
    // Generate a unique ID based on node ID.
    $variables['unique_page_id'] = 'page-' . $node->id();
  }
// for hero section
   if (!empty($variables['node']) && $variables['node']->hasField('field_hero_section')) {
    $variables['content']['field_hero_section'] = $variables['node']->get('field_hero_section')->view();
  }

// for view header section
  $route = \Drupal::routeMatch();
  $route_name = $route->getRouteName();

  // Check if the route is a view page.
  if (strpos($route_name, 'view.') === 0) {

    // Break route name: view.view_machine_name.display_id
    $parts = explode('.', $route_name);
    $view_id = $parts[1];
    $display_id = $parts[2];

    // Load the view.
    $view = \Drupal\views\Views::getView($view_id);
    if ($view) {
      $view->setDisplay($display_id);
      $render = $view->render();

      // Get header value
      if (isset($view->display_handler->display['display_options']['header'])) {
        $header_items = $view->display_handler->display['display_options']['header'];
        foreach ($header_items as $key => $header) {
          if ($header['plugin_id'] == 'text') {
            $variables['page']['view_header'] = \Drupal\Component\Utility\Xss::filter($header['content']['value']);
          }
        }
      }
    }
  }

}

// Generate a random string
	function random_string()
	{
		$character_set_array = array();
		$character_set_array[] = array('count' => 4, 'characters' => 'abcdefghijklmnopqrstuvwxyz');
		$character_set_array[] = array('count' => 4, 'characters' => '0123456789');
		$temp_array = array();
		foreach ($character_set_array as $character_set) {
			for ($i = 0; $i < $character_set['count']; $i++) {
				$temp_array[] = $character_set['characters'][rand(0, strlen($character_set['characters']) - 1)];
			}
		}
		shuffle($temp_array);
		return implode('', $temp_array);
	}
	
function cbc_preprocess_html(array &$variables) {
  $account = \Drupal::currentUser();
  foreach ($account->getRoles() as $role) {
    $variables['attributes']['class'][] = 'role-' . $role;
  }

  if ($node = \Drupal::request()->attributes->get('node')) {
    $variables['attributes']['class'][] = 'page-node-' . $node->id();
    // If you meant to use alias, implement it meaningfully or remove the line.
  }

  $langcode = \Drupal::languageManager()->getCurrentLanguage()->getId();
  $variables['attributes']['class'][] = 'lang-' . $langcode;
}

/**
 * Implements hook_preprocess_views_view().
 */
function cbc_preprocess_views_view(&$variables) {
  
  // Attach board of directors library
  if ($variables['view']->id() === 'board_of_directors') {
    $variables['#attached']['library'][] = 'cbc/board-of-directors';
  }
  
  // Attach portfolio library
  if ($variables['view']->id() === 'portfolio') {
    $variables['#attached']['library'][] = 'cbc/portfolio';
  }
  
  // Attach key executive library
  if ($variables['view']->id() === 'key_executive') {
    $variables['#attached']['library'][] = 'cbc/key-executive';
  }
  
  // Attach energy bill library
  if ($variables['view']->id() === 'energy_bill') {
    $variables['#attached']['library'][] = 'cbc/energy-bill';
  }
  
  // Attach tariff petition library
  if ($variables['view']->id() === 'tariff_petition') {
    $variables['#attached']['library'][] = 'cbc/tariff-petition';
  }
  
  // Attach tender library
  if ($variables['view']->id() === 'tender') {
    $variables['#attached']['library'][] = 'cbc/tender';
  }
  
  $variables['current_language'] = \Drupal::languageManager()->getCurrentLanguage()->getId();

}


function cbc_preprocess_views_view_unformatted(array &$variables) {
  $variables['current_language'] = \Drupal::languageManager()->getCurrentLanguage()->getId();
}

/**
 * Implements hook_preprocess_links().
 * Add hreflang attribute to language switcher list items.
 */
function cbc_preprocess_links(&$variables) {
  // Check if this is a language switcher block.
  if (isset($variables['links']) && is_array($variables['links'])) {
    foreach ($variables['links'] as $key => &$link) {
      // Check if link has language information.
      if (isset($link['link']['#url'])) {
        /** @var \Drupal\Core\Url $url */
        $url = $link['link']['#url'];
        // Get language from the URL or link options.
        if (method_exists($url, 'getOption') && $language = $url->getOption('language')) {
          // FIX: Add hreflang attribute to the URL (anchor tag), NOT the list item (LI).
          // W3C Validator Error: Attribute hreflang not allowed on element li.
          $options = $url->getOptions();
          $options['attributes']['hreflang'] = $language->getId();
          $url->setOptions($options);
        }
      }

      // Explicitly remove hreflang from the list item attributes.
      if (isset($link['attributes'])) {
        if ($link['attributes'] instanceof \Drupal\Core\Template\Attribute) {
          $link['attributes']->removeAttribute('hreflang');
        }
        elseif (is_array($link['attributes']) && isset($link['attributes']['hreflang'])) {
          unset($link['attributes']['hreflang']);
        }
      }
    }
  }
}

/**
 * Implements hook_preprocess_input().
 * Fixes W3C validation error: Attribute autocomplete not allowed on type="submit".
 */
function cbc_preprocess_input(&$variables) {
  $element = $variables['element'];
  $type = $element['#type'] ?? 'text'; // Default to text if not set?

  // List of types allowed to have autocomplete attribute.
  // Source: W3C / HTML5 spec.
  $allowed_autocomplete_types = [
    'color', 'date', 'datetime-local', 'email', 'month', 
    'number', 'password', 'range', 'search', 'tel', 'text', 'time', 'url', 'week'
  ];

  // Logic to handle 'autocomplete' attribute.
  if (isset($variables['attributes']) && $variables['attributes'] instanceof \Drupal\Core\Template\Attribute) {
    if (in_array($type, $allowed_autocomplete_types)) {
      // Original theme intent: Default to autocomplete="off" if not explicitly set.
      if (!$variables['attributes']->offsetExists('autocomplete')) {
        $variables['attributes']->setAttribute('autocomplete', 'off');
      }
    }
    else {
      // Remove autocomplete if present on invalid types (submit, button, hidden, etc).
      // This fixes the W3C validation error.
      $variables['attributes']->removeAttribute('autocomplete');
    }
  }
  elseif (isset($variables['attributes']) && is_array($variables['attributes'])) {
    // Array fallback.
    if (in_array($type, $allowed_autocomplete_types)) {
       if (!isset($variables['attributes']['autocomplete'])) {
         $variables['attributes']['autocomplete'] = 'off';
       }
    }
    else {
       if (isset($variables['attributes']['autocomplete'])) {
         unset($variables['attributes']['autocomplete']);
       }
    }
  }
}

/**
 * Implements hook_form_alter().
 * Add placeholder to search form input.
 */
function cbc_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  // Add placeholder to search form block
  if ($form_id == 'search_block_form' || isset($form['keys'])) {
    if (isset($form['keys'])) {
      $form['keys']['#attributes']['placeholder'] = 'Search';
    }
  }

  // Rate Limiting for Webforms (e.g., feedback, contact)
  // Check if this is a webform submission.
  if (strpos($form_id, 'webform_submission_') === 0) {
    // Add custom validation handler.
    $form['#validate'][] = 'cbc_form_validate_rate_limit';
    
    // Add custom validation handler.
    $form['#validate'][] = 'cbc_form_validate_rate_limit';
    
    // Add #after_build callback to suppress top errors
    $form['#after_build'][] = 'cbc_form_after_build_suppress_errors';
  }
}

/**
 * #after_build callback to suppress top-level error messages.
 */
function cbc_form_after_build_suppress_errors(array $form, FormStateInterface $form_state) {
  cbc_suppress_top_errors($form);
  return $form;
}

/**
 * Helper function to recursively suppress top-level error messages for form elements.
 */
function cbc_suppress_top_errors(array &$elements) {
  // Use Element::children to iterate only over renderable children (skipping properties like #)
  foreach (\Drupal\Core\Render\Element::children($elements) as $key) {
    // If it is an element with a type, suppressing the message at the top level
    // ensures it only renders in the inline template.
    if (isset($elements[$key]['#type'])) {
      $elements[$key]['#error_no_message'] = TRUE;
    }
    // Recurse into containers/groups
    cbc_suppress_top_errors($elements[$key]);
  }
}

/**
 * Custom validation handler for rate limiting.
 */
/**
 * Custom validation handler for rate limiting.
 */
function cbc_form_validate_rate_limit(&$form, FormStateInterface $form_state) {
  // Use Drupal's Flood service.
  $flood = \Drupal::flood();
  $limit = 5; // 5 submissions
  $window = 600; // 10 minutes (600 seconds)
  $identifier = \Drupal::request()->getClientIp(); // Track by IP address
  
  // Default event name
  $name = 'cbc.webform_submission';

  // Get specific Webform ID from the form array
  if (isset($form['#webform_id'])) {
    $webform_id = $form['#webform_id'];
    $name .= '.' . $webform_id; // e.g. cbc.webform_submission.feedback
  }
  // Fallback: try to get from form attributes
  elseif (isset($form['#attributes']['data-webform-id'])) {
    $webform_id = $form['#attributes']['data-webform-id'];
    $name .= '.' . $webform_id;
  }
  // Last resort: try form_id
  elseif (isset($form['#form_id']) && preg_match('/webform_submission_(.+)_add_form/', $form['#form_id'], $matches)) {
    $webform_id = $matches[1];
    $name .= '.' . $webform_id;
  }

  // Check if the user is allowed to proceed.
  if (!$flood->isAllowed($name, $limit, $window, $identifier)) {
    // Rate limit exceeded.
    $message = t('Too many submissions. Please wait 10 minutes before trying again.');
    
    // Set form error (global validation error)
    $form_state->setErrorByName('', $message);
    
    // Also set a standard Drupal message to ensure visibility
    \Drupal::messenger()->addError($message);
  }
  else {
    // Register the event.
    $flood->register($name, $window, $identifier);
  }
}

/**
 * Implements hook_preprocess_form_element().
 * Passes errors to the form element template explicitly.
 */
function cbc_preprocess_form_element(&$variables) {
  $element = $variables['element'];
  // If the element has errors but variables['errors'] is empty (due to suppression), restore it.
  if (isset($element['#errors']) && empty($variables['errors'])) {
    $variables['errors'] = $element['#errors'];
  }
}

/**
 * Implements hook_preprocess_textarea().
 * Passes errors to the textarea template.
 */
function cbc_preprocess_textarea(&$variables) {
  $element = $variables['element'];
  if (isset($element['#errors'])) {
    $variables['errors'] = $element['#errors'];
  }
  // Remove 'pattern' attribute as it is invalid for textarea elements
  if (isset($variables['attributes']['pattern'])) {
    unset($variables['attributes']['pattern']);
  }
  if ($variables['attributes'] instanceof \Drupal\Core\Template\Attribute) {
    $variables['attributes']->removeAttribute('pattern');
  }
}

/**
 * Implements hook_preprocess_text_format_wrapper().
 * Passes errors to the text format wrapper template.
 */
function cbc_preprocess_text_format_wrapper(&$variables) {
  $element = $variables['element'];
  if (isset($element['#errors'])) {
    $variables['errors'] = $element['#errors'];
  }
}

