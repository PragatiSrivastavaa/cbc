  
  <section class="container py-5">
  <div class="row">
    <div class="col-lg-11 mx-auto">
      <div class="content-section">
        <div class="table-responsive mt-4">
          <table class="table table-bordered">
            <thead style="background-color: #0066b3; color: white;">
              <tr>
                <th scope="col" style="width: 80px; text-align: center; font-weight: 600; text-transform: uppercase; background-color: #0066b3; color: white;">S.No</th>
                <th scope="col" style="font-weight: 600; text-transform: uppercase; background-color: #0066b3; color: white;">Title</th>
                <th scope="col" style="width: 180px; text-align: center; font-weight: 600; text-transform: uppercase; background-color: #0066b3; color: white;">Document/Link</th>
              </tr>
            </thead>
            <tbody>
			  {% for row in rows %}
              {% set entity = row.content['#row']._entity %}
                   {% set link_item = entity.field_link.0 %}

                {% if link_item %}
                  {# Convert internal/external link to usable URL #}
                  {% set link = link_item.url %}
                {% else %}
                  {# If linked field is empty, link to node page #}
                  {% set link = path('entity.node.canonical', {'node': entity.id()}) %}
                {% endif %}
              <tr>
               <td style="text-align:center;">{{ loop.index }}</td>
      
                <td>{{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ title }}'] }}</td>
                <td><a href="{{ link }}" target="_blank" class="text-primary">View</a></td>
              </tr>
             
             {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</section>
