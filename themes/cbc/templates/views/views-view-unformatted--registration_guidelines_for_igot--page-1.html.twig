

 <section class="karmayogi-section-fullwidth karmayogi-vision-section">
  <div class="container">
    <div class="karmayogi-content-wrapper">
      <div class="karmayogi-metrics-table-wrapper" style="margin-top: 40px;">

        <table class="table karmayogi-metrics-table">
          <thead>
            <tr>
              <th style="width: 80px;">S.NO</th>
              <th>Title</th>
              <th style="width: 300px;">Documents</th>
            </tr>
          </thead>

          <tbody>
            {% for row in rows %}
              {% set node = row.content['#row']._entity %}
              {% set file = node.field_document.entity %}

              {% if file %}
                <tr>
                  <td>{{ loop.index }}</td>

                  <!-- TITLE -->
                  <td style="color:#002b5b;">
                    {{ node.label }}
                  </td>

                  <!-- DOCUMENT INFO -->
                  <td>
                    <a href="{{ file_url(file.uri.value) }}"
                       target="_blank"
                       rel="noopener"
                       style="color:#0063ae; font-weight:600;">
                      View Document
                    </a>

                    <span style="display:block; font-size:0.9rem; color:#6c757d; margin-top:5px;">
                      (Format: {{ file.filename.value|split('.')|last|upper }},
                      Language: {{ node.langcode.value|upper }},
                      Size: {{ file.filesize.value|format_size }})
                    </span>
                  </td>
                </tr>
              {% endif %}
            {% endfor %}
          </tbody>

        </table>

      </div>
    </div>
  </div>
</section>




    


