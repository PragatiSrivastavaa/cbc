{{ attach_library('cbc/case-studies-gallery') }}
 <section class="karmayogi-section-fullwidth karmayogi-vision-section" style="padding: 50px 0;">
    <div class="container">
      <div class="row">
        <div class="col-12">
          <div class="karmayogi-content-wrapper">
            <h2 class="karmayogi-section-title text-center" style="margin-bottom: 40px;">
              <i class="bi bi-file-earmark-pdf-fill me-3" style="color: #0063ae;"></i>Case Studies
            </h2>
            <div class="case-studies-carousel-wrapper position-relative">
              <button class="case-studies-nav-btn case-studies-nav-prev" aria-label="Previous">
                <i class="fas fa-chevron-left"></i>
              </button>
         <div class="case-studies-carousel-container">
  <div class="case-studies-carousel-track">

    {% for row in rows %}
  {% set node = row.content['#row']._entity %}
  {% set file = node.field_document.entity %}

  {% if file %}
    <div class="case-studies-carousel-item">
      <a href="{{ file_url(file.uri.value) }}"
         class="card case-study-card"
         target="_blank"
         rel="noopener">

        <div class="case-study-icon">
          <i class="bi bi-file-earmark-pdf-fill"></i>
        </div>

        <div class="card-body">
          <h3 class="card-title">{{ node.label }}</h3>
          <p class="card-text">Case Study</p>
        </div>

      </a>
    </div>
  {% endif %}
{% endfor %}


  </div>
</div>

     

              <button class="case-studies-nav-btn case-studies-nav-next" aria-label="Next">
                <i class="fas fa-chevron-right"></i>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>