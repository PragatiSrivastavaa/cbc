<section class="karmayogi-section-fullwidth">
  <div class="container">
    <div class="row">
      <div class="col-lg-10 offset-lg-1">
        <div class="newsletters-list" id="newslettersList">
          {% for row in rows %}
            {% set entity = row.content['#row']._entity %}
            {% set tokens = row.content['#view'].style_plugin.render_tokens[loop.index0] %}

            {% set link_url = path('entity.node.canonical', {'node': entity.id}) %}

            {% if entity.field_document|length > 0 %}
              {% set file_entity = entity.field_document.0.entity %}
              {% set link_url = file_url(file_entity.fileuri) %}
            {% endif %}

            <article class="newsletter-item">
              <div class="newsletter-content">
                <h3 class="newsletter-title">
                  <a href="{{ link_url }}" target="_blank" rel="noopener noreferrer">
                    {{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ title }}'] }}
                  </a>
                </h3>
                <p class="newsletter-date">{{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ field_start_date }}'] }}</p>
              </div>
            </article>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>
  