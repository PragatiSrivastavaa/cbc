{{ attach_library('cbc/know-your-cbc') }}
<section class="container py-5">
  <div class="row">
    <div class="col-lg-12">
      <div class="content-section">


        <!-- Document Pages Carousel Section -->
        <div class="document-carousel-section text-center mt-5 mb-5">
          <h2 class="mb-4">Know Your CBC</h2>
          <p class="lead">Learn about the Capacity Building Commission, its structure, leadership, and how we work to
            transform civil service capacity building in India.</p>
          <!-- Video Section -->

          <div class="video-section container mt-5 mb-5">
            <div class="video-wrapper">
              <div class="ratio ratio-16x9">
                <video class="w-100" controls preload="metadata">
                  <source src="{{ base_path }}{{ directory }}/img/Mission_Karmayogi.mp4" type="video/mp4">
                  Your browser does not support the video tag.
                </video>
              </div>
            </div>
          </div>


          <div class="document-carousel-wrapper position-relative">
            <div class="carousel-controls">
              <button id="documentPrevBtn" aria-label="Previous page">‹</button>
              <button id="documentNextBtn" aria-label="Next page">›</button>
            </div>


            <!-- Presentation pages - Drupal compatible -->
            <!-- 
                For Drupal integration:
                1. Replace '../../img/about_cbc_presentation/' with:
                   {{ base_path }}{{ directory }}/img/about_cbc_presentation/
                   OR use file_url() function if images are in files directory
                2. All 28 pages are pre-rendered as static HTML (no JS required to load)
                3. Navigation uses minimal JS with scrollIntoView (Drupal-safe)
              -->

            <div class="document-carousel-track" id="documentCarouselTrack">
              {% for row in rows %}
              <div class="document-page" id="kyc-page-{{ loop.index }}" data-page-number="{{ loop.index }}">
                <div class="document-page-content">
                  <div class="pdf-page-container">
                    {{ row.content }}
                  </div>
                </div>
              </div>
              {% endfor %}
            </div>


            <div class="carousel-indicators">
              <span id="currentPage">1</span> /
              <span id="totalPages">{{ rows|length }}</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>