  {% for row in rows %}
    {% set node = row.content['#row']._entity %}
    {% set category = node.field_category.entity.label() %}

    {% if category == 'In Focus' %}
      <h2 class="infocus-heading">
        {{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ title }}'] }}
      </h2>

      <!-- <p class="infocus-desc"> -->
        <div class="infocus-map-container">
          <div class="map-image-container">
            {{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ field_body }}'] }}
          </div>
        </div>

    {% endif %}
  {% endfor %}

