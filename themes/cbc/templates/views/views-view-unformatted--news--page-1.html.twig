<section class="karmayogi-section-fullwidth">
  <div class="container">
    <div class="row">
      <div class="col-lg-10 offset-lg-1">
        <div class="whats-new-list" id="whatsNewList">

          {% for row in rows %}
            {% set node = row.content['#row']._entity %}
        {% set entity = row.content['#row']._entity %}
        {% set title_text = row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ title }}'] %}
                   {% set link_item = entity.field_link.0 %}

                {% if link_item %}
                  {# Convert internal/external link to usable URL #}
                  {% set link = link_item.url %}
                {% else %}
                  {# If linked field is empty, link to node page #}
                  {% set link = path('entity.node.canonical', {'node': entity.id()}) %}
                {% endif %}

            {% if node.field_category is not empty
              and node.field_category.entity.label() == "What's New" %}

              <article class="whats-new-item">

                {# SAFE date handling #}
                {% if node.field_end_date is not empty
                  and node.field_end_date.0.value is not empty %}

                  {% set start_date = node.field_end_date.0.value|date('Y-m-d') %}
                  {% set today = 'now'|date('Y-m-d') %}

                  {% if start_date >= today %}
                    <!-- <div class="new-badge">
                      <span class="badge-text">NEW</span>
                    </div> -->
                  {% endif %}
                {% endif %}

                <div class="whats-new-content">

              <a href="{{ link }}" target="_blank" rel="noopener noreferrer">
                <h3 class="whats-new-title">{{ title_text }}</h3>
              </a>
            

                  {# Display date safely #}
                  {% if node.field_end_date is not empty %}
                    <p class="whats-new-date">
                      {{ node.field_end_date.0.value|date('d M Y') }}
                    </p>
                  {% endif %}
                </div>

              </article>
            {% endif %}
          {% endfor %}

        </div>
      </div>
    </div>
  </div>
</section>
