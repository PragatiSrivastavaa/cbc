<section class="container py-5">
  <div class="row">
    <div class="col-lg-12">
      <div class="content-section">
        <p class="lead">Explore our collection of videos featuring insights from leadership, initiatives, and capacity building programs.</p>
        
        <ul class="video-gallery-grid-page mt-5 list-unstyled p-0 m-0" id="videoGalleryPage">
{% for row in rows %}
          {% set node = row.content['#row']._entity %}
          {% set tokens = row.content['#view'].style_plugin.render_tokens[loop.index0] %}
          {% set video_url = '' %}

          {# Get video file #}
          {% if node.field_video.entity is not empty %}
            {% set media = node.field_video.entity %}
            {% if media.field_media_video_file.entity is not empty %}
              {% set file = media.field_media_video_file.entity %}
              {% set video_url = file_url(file.uri.value) %}
            {% endif %}
          {% endif %}

          <li class="video-gallery-card-page">
            <div class="video-container-page">
              {% if video_url %}
              <video class="w-100 rounded-3" controls muted preload="metadata">
                <source
                  src="{{ video_url }}"
                  type="video/mp4">
              </video>
              {% endif %}
            </div>
            <div class="video-caption-page">
              <h4 class="video-title-page">{{row.content['#view'].style_plugin.render_tokens[ loop.index0 ]['{{ title }}'] }}</h4>
              <p class="video-description-page">{{row.content['#view'].style_plugin.render_tokens[ loop.index0 ]['{{ field_event_description }}']|striptags|trim }}</p>
            </div>
          </li>


{% endfor  %}
          </ul>
    </div>
  </div>
  </div>
</section>