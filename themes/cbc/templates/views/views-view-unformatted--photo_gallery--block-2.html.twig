<section class="karmayogi-section-fullwidth karmayogi-milestones-section">
    <div class="container">
      <h2 class="karmayogi-section-title text-center">
        <i class="bi bi-images me-3" ></i>Photo Gallery
      </h2>
      <div class="karmayogi-content-wrapper">
        <div class="gallery-carousel-wrapper position-relative" >
        <button class="gallery-nav-btn gallery-nav-prev" aria-label="Previous" >
          <i class="bi bi-chevron-left"></i>
        </button>
        <div class="gallery-carousel-container" style="overflow: hidden; position: relative; width: 100%; padding: 10px 0;">
          <div class="gallery-carousel-track" >
          {% for row in rows %}
              {% set entity = row.content['#row']._entity %}
              {% set tokens = row.content['#view'].style_plugin.render_tokens[loop.index0] %}
              <div class="gallery-carousel-item" >
              <div class="card high-contrast-border">
                {% if entity.field_thumbnail_image is not empty and entity.field_thumbnail_image.0.entity %}
                    {% set file = entity.field_thumbnail_image.0.entity %}
                     {% set img_url = file_url(file.fileuri) %}

                    <img src="{{ img_url }}" class="w-100 rounded-3" alt="{{ tokens['{{ title }}'] }}">
                    {% endif %}

                <div class="card-body" >
                  <h5 class="card-title">{{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ title }}'] }}</h5>
                  <p class="card-text">{{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ field_event_description }}'] }}</p>
                </div>
              </div>
            </div>
          {% endfor  %}
        </div>
        </div>
        <button class="gallery-nav-btn gallery-nav-next" aria-label="Next">
          <i class="bi bi-chevron-right"></i>
        </button>
        </div>
      </div>
    </div>
  </section>
