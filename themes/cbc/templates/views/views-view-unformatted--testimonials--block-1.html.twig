<div class="vertical-testimonials-scroll" id="videoTestimonials">
   <div class="opinions-vertical-box">
                {% for row in rows %}
          {% set node = row.content['#row']._entity %}
          {% set tokens = row.content['#view'].style_plugin.render_tokens[loop.index0] %}
          {% set video_url = '' %}

          {# Get video file #}
          {% if node.field_video.entity is not empty %}
            {% set media = node.field_video.entity %}
            {% if media.field_media_video_file.entity is not empty %}
              {% set file = media.field_media_video_file.entity %}
              {% set video_url = file_url(file.uri.value) %}
            {% endif %}
          {% endif %}

           {% if video_url %}
            <video class="testimonial-video active" muted playsinline>
              <source src="{{ video_url }}" type="video/mp4">
              <track label="English" kind="captions" srclang="en" src="/themes/cbc/vtt/{{ video_url|split('/')|last|replace({'.mp4': ''}) }}.vtt" default>
              Your browser does not support the video tag.
            </video>
             {% endif %}
            


    {% endfor %}
    </div>
          <button class="video-unmute-btn" id="videoUnmuteBtn" title="Click to unmute">
            <i class="fas fa-volume-mute"></i>
          </button>

          </div>