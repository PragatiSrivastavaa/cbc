  
  <section class="container py-5">
  <div class="row">
    <div class="col-lg-11 mx-auto">
      <div class="content-section">
        <div class="mou-status-table-wrapper mt-4">
          <div class="table-responsive">
            <table class="table mou-status-table collaboration-table">
            <thead>
              <tr>
                <th scope="col" class="text-center" style="width: 60px;">S.No</th>
                <th scope="col" style="width: 50%;">Title</th>
                <th scope="col" class="text-center" style="width: 120px;">Document/Link</th>
              </tr>
            </thead>
            <tbody>
			  {% for row in rows %}
              {% set entity = row.content['#row']._entity %}
                   {% set link_item = entity.field_link.0 %}

                {% if link_item %}
                  {# Convert internal/external link to usable URL #}
                  {% set link = link_item.url %}
                {% else %}
                  {# If linked field is empty, link to node page #}
                  {% set link = path('entity.node.canonical', {'node': entity.id()}) %}
                {% endif %}
              <tr>
               <td class="text-center">{{ loop.index }}</td>
      
                <td>{{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ title }}'] }}</td>
                <td class="text-center"><a href="{{ link }}" target="_blank" class="action-link">View</a></td>
              </tr>
             
             {% endfor %}
            </tbody>
          </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
