 <section class="karmayogi-section-fullwidth karmayogi-vision-section">
    <div class="container">
      <div class="karmayogi-content-wrapper">
        <h2 class="karmayogi-section-title">
          <i class="bi bi-file-earmark-text-fill me-3" style="color: #0063ae;"></i>ACBP Process Manual
        </h2>
        <div class="karmayogi-metrics-table-wrapper">
          <table class="table karmayogi-metrics-table">
            <thead>
              <tr>
                <th>Title</th>
                <th style="text-align: center;">View Document</th>
                <th style="text-align: center;">Download Document</th>
              </tr>
            </thead>
            <tbody>
   {% for row in rows %}
              {% set entity = row.content['#row']._entity %}
              <tr>
                <td style="color: #002b5b; font-weight: 500;">{{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ title }}'] }}</td>
                <td style="text-align: center;">
                  <a href="{{ link }}" target="_blank" style="color: #0063ae; text-decoration: none; font-weight: 600; transition: all 0.3s ease;" onmouseover="this.style.textDecoration='underline'; this.style.color='#004b88';" onmouseout="this.style.textDecoration='none'; this.style.color='#0063ae';">View</a>
                </td>
                <td style="text-align: center;">
                  <a href="{{ link }}" download style="color: #0063ae; text-decoration: none; font-weight: 600; transition: all 0.3s ease;" onmouseover="this.style.textDecoration='underline'; this.style.color='#004b88';" onmouseout="this.style.textDecoration='none'; this.style.color='#0063ae';">Download</a>
                </td>
              </tr>
               
             {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>