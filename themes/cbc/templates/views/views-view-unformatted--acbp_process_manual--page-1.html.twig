 <section class="karmayogi-section-fullwidth karmayogi-vision-section">
    <div class="container">
      <div class="karmayogi-content-wrapper">
        <h2 class="karmayogi-section-title">
          <i class="bi bi-file-earmark-text-fill me-3" style="color: #0063ae;"></i>ACBP Process Manual
        </h2>
        <div class="mou-status-table-wrapper">
          <div class="table-responsive">
            <table class="table mou-status-table collaboration-table">
            <thead>
              <tr>
                <th>Title</th>
                <th class="text-center">View Document</th>
                <th class="text-center">Download Document</th>
              </tr>
            </thead>
            <tbody>
   {% for row in rows %}
              {% set entity = row.content['#row']._entity %}
              <tr>
                <td>{{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ title }}'] }}</td>
                <td class="text-center">
                  <a href="{{ link }}" target="_blank" class="action-link">View</a>
                </td>
                <td class="text-center">
                  <a href="{{ link }}" download class="action-link">Download</a>
                </td>
              </tr>
               
             {% endfor %}
            </tbody>
          </table>
        </div>
        </div>
      </div>
    </div>
  </section>