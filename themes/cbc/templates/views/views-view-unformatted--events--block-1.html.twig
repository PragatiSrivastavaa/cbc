{#
/**
 * @file
 * Theme override to display a view of unformatted rows.
 *
 * Available variables:
 * - title: The title of this group of rows. May be empty.
 * - rows: A list of the view's row items.
 *   - attributes: The row's HTML attributes.
 *   - content: The row's content.
 * - view: The view object.
 * - default_row_class: A flag indicating whether default classes should be
 *   used on rows.
 *
 * @see template_preprocess_views_view_unformatted()
 */
#}
  <!-- Events Cards Only (Full Width) -->
        <div class="events-content-wrapper high-contrast-no-border" role="region" aria-label="Carousel">
          <div class="events-cards-container high-contrast-no-border" aria-live="polite" aria-atomic="true">
            <ul class="events-cards-list high-contrast-no-border list-unstyled p-0 m-0" id="homeEventsCardsList">
              <!-- Event Card 1 -->
                {% for row in rows %}
                 {% set node = row.content['#row']._entity %}
              <li class="home-event-card high-contrast-border" data-event-id="home-event-1" data-date="2025-11-07"
                data-venue="Capacity Building Commission">
                <div class="home-event-card-image">
                  {% if node.field_event_images.0.entity %}
                    <img src="{{ file_url(node.field_event_images.0.entity.fileuri) }}" alt="" loading="lazy">
                  {% endif %}
                </div>
                <div class="home-event-card-content">
                  <div class="home-event-card-date">
                    <i class="fas fa-calendar"></i> {{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ field_event_start }}'] }}
                  </div>
                  <a href="{{ path('entity.node.canonical', {'node': node.id}) }}">
                    <h3 class="home-event-card-title">{{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ title }}'] }}</h3>
                  </a>
                  {% set description = row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ field_event_description }}']|striptags|trim %}
                  {% set truncated_description = description|length > 100 ? description|slice(0, 100) ~ '...' : description %}
                  <p class="home-event-card-description">{{ truncated_description }}</p>
                  <a class="home-event-card-read-more" href="{{ path('entity.node.canonical', {'node': node.id}) }}" aria-label="Read more about {{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ title }}']|striptags|trim }}">
                    Read More <i class="fas fa-arrow-right"></i>
                  </a>
                </div>
              </li>
              {% endfor %}
            </ul>
          </div>
        </div>
        <!-- End of Events Cards Only (Full Width) -->