<!-- Photo Gallery Section - Left -->
<div class="youtube-section p-3 rounded-4 socil-bg position-relative h-100">
              <div class="d-flex justify-content-between align-items-center mb-3">
                <h3 class="social-heading d-flex align-items-center gap-2 mb-0">
                  <i class="fas fa-images text-info"></i> Photo Gallery
                </h3>
                <div class="d-flex align-items-center gap-3">
                  <div class="carousel-controls d-flex gap-2">
                    <button class="photo-prev"><i class="fas fa-chevron-left"></i></button>
                    <button class="photo-pause-btn" id="photoPauseBtn" aria-label="Pause Photo Carousel"><i class="fas fa-pause"></i></button>
                    <button class="photo-next"><i class="fas fa-chevron-right"></i></button>
                  </div>
                </div>
              </div>

              <div class="youtube-carousel-wrapper position-relative" role="region" aria-label="Carousel">
                <ul class="youtube-carousel d-flex list-unstyled p-0 m-0" id="photoCarousel" aria-live="polite" aria-atomic="true">
                  <!-- Photo 1 -->
             {% for row in rows %}
              {% set entity = row.content['#row']._entity %}
              {% set tokens = row.content['#view'].style_plugin.render_tokens[loop.index0] %}
                  <li class="youtube-card high-contrast-border flex-shrink-0 w-100" data-type="photo">
                    <div class="video-container">
                     {% if entity.field_thumbnail_image is not empty and entity.field_thumbnail_image.0.entity %}
                    {% set file = entity.field_thumbnail_image.0.entity %}
                     {% set img_url = file_url(file.fileuri) %}

                    <img src="{{ img_url }}" class="w-100 rounded-3" alt="{{ tokens['{{ title }}'] }}">
                    {% endif %}

                    </div>
                    <div class="video-caption">
                      <h3 class="video-title">{{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ title }}'] }}</h3>
                      <p class="video-description">{{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ field_event_description }}']|striptags|trim }}</p>
                    </div>
                  </li>
                  {% endfor %}
                </ul>
              </div>

              <!-- View All Button -->
              <div class="video-gallery-footer text-end">
                <a href="/photo-gallery" class="view-all-videos-btn" aria-label="View all photos">
                  View All Photos <i class="fas fa-arrow-right"></i>
                </a>
              </div>
            </div>