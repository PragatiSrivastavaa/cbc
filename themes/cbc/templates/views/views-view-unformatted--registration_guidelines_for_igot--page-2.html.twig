<section class="karmayogi-section-fullwidth karmayogi-vision-section">
  <div class="container">
    <div class="karmayogi-content-wrapper">
      <div class="mou-status-table-wrapper" style="margin-top: 40px;">
        <div class="table-responsive">
        <table class="table mou-status-table collaboration-table">
          <thead>
            <tr>
              <th style="width: 80px;">S.NO</th>
              <th>Title</th>
              <th>Circular Date</th>
              <th>Upload Date</th>
              <th>Documents</th>
            </tr>
          </thead>

          <tbody>
            {% for row in rows %}
              {% set node = row.content['#row']._entity %}
              {% set file = node.field_document.entity ?? null %}

              {% if file %}
                <tr>
                  <td>{{ loop.index }}</td>

                  <!-- TITLE -->
                  <td>
                    {{ node.label }}
                  </td>

                  <!-- DATES -->
                  <td>{{ node.field_circular_date.value|date("d-m-Y") }}</td>
                  <td>{{ node.field_upload_date.value|date("d-m-Y") }}</td>

                  <!-- DOCUMENT -->
                  <td>
                    <a href="{{ file_url(file.uri.value) }}"
                       target="_blank"
                       rel="noopener"
                       class="action-link">
                      View Document
                    </a>

                    <span style="display:block; font-size:0.9rem; color:#6c757d; margin-top:5px;">
                      (Format: {{ file.filename.value|split('.')|last|upper }},
                      Language: {{ node.langcode.value|upper }},
                      Size:
                      {% if file.filesize.value is not empty %}
                        {{ file.filesize.value|format_size }}
                      {% else %}
                        -
                      {% endif %}
                      )
                    </span>
                  </td>
                </tr>
              {% endif %}
            {% endfor %}
          </tbody>

        </table>
        </div>

      </div>
    </div>
  </div>
</section>