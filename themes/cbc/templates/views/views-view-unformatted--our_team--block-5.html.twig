<div class="container">  
 <!-- Contact Information Section -->
            <div class="row mb-5">
              <div class="col-12">
                 <div class="team-category">
                  <h3 class="team-category-title mb-4">Our Pillars</h3>
                  <div class="row g-3 pillar-cards-row">
                    {% for row in rows %}
                      {% set role_text = row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ field_team_members }}']|striptags|trim|upper %}
                      {# Check for both regular and PS/PPS members to show all in one line #}
                      <div class="col-pillar">
                        <div class="team-member-card no-overlay-card contact-info-card {{ 'PS' in role_text ? 'is-ps-pps' : '' }}">
                          <div class="team-member-info">
                            <h3 class="team-member-name">{{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ field_piller_content }}'] }}</h3>
                            <h4 class="team-member-name">{{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ title }}'] }}</h4>
                            <p class="team-member-role">{{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ field_team_members }}'] }}</p>
                            <div class="contact-details">
                              {% set phone = row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ field_phone }}'] %}
                              {% set email = row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ field_email }}'] %}
                              <p class="contact-item" title="{{ phone|striptags|trim }}"><i class="fas fa-phone"></i>{{ phone }}</p>
                              <p class="contact-item" title="{{ email|striptags|trim }}"><i class="fas fa-envelope"></i>{{ email }}</p>
                            </div>
                          </div>
                        </div>
                      </div>
                    {% endfor %}
                  </div>
                </div>
              </div>
            </div>
            </div> 