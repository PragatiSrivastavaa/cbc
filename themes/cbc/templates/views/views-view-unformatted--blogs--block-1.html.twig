<div class="section-header media-header-bg">
  <h3 class="section-header-title">{% if language == 'hi' %}ब्लॉग्स{% else %}BLOGS{% endif %}</h3>
  <div class="section-header-controls">
    <button class="toggle-slide" id="toggleBlockSlideBtn" title="Pause/Play">
      <i class="fas fa-pause"></i>
    </button>
  </div>
</div>
<div class="section-body">
  <div class="media-corner-box high-contrast-border position-relative" role="region" aria-label="Carousel">
    <ul class="media-track list-unstyled p-0 m-0" id="blockTrack">
      {% for row in rows %}
        {% set entity = row.content['#row']._entity %}
        {% set tokens = row.content['#view'].style_plugin.render_tokens[loop.index0] %}

        {# Determine Link URL: URL field > Uploaded File > Node page #}
        {% set link = '' %}

        {% if entity.field_content_url.0.url is not empty %}
          {% set link = entity.field_content_url.0.url %}
        {% elseif entity.field_content_url.0.uri is not empty %}
          {% set link = entity.field_content_url.0.uri %}
        {% elseif entity.field_url.0.url is not empty %}
          {% set link = entity.field_url.0.url %}
        {% elseif entity.field_url.0.uri is not empty %}
          {% set link = entity.field_url.0.uri %}
        {% elseif entity.field_link.0.url is not empty %}
          {% set link = entity.field_link.0.url %}
        {% elseif entity.field_link.0.uri is not empty %}
          {% set link = entity.field_link.0.uri %}
        {% elseif tokens['{{ field_content_url }}'] is not empty %}
          {% set link = tokens['{{ field_content_url }}']|striptags|trim %}
        {% elseif tokens['{{ field_url }}'] is not empty %}
          {% set link = tokens['{{ field_url }}']|striptags|trim %}
        {% endif %}

        {% if link is empty %}
          {% if entity.field_content_upload_file.0.entity is not empty %}
            {% set link = file_url(entity.field_content_upload_file.0.entity.fileuri) %}
          {% elseif entity.field_upload_file.0.entity is not empty %}
            {% set link = file_url(entity.field_upload_file.0.entity.fileuri) %}
          {% elseif entity.field_file.0.entity is not empty %}
            {% set link = file_url(entity.field_file.0.entity.fileuri) %}
          {% elseif entity.field_document.0.entity is not empty %}
            {% set link = file_url(entity.field_document.0.entity.fileuri) %}
          {% endif %}
        {% endif %}

        {% if link is empty %}
          {% set link = path('entity.node.canonical', {'node': entity.id()}) %}
        {% endif %}

        {# Determine Image URL #}
        {% set img_url = '' %}
        {% if entity.field_content_upload_image.0.entity is not empty %}
          {% set img_url = file_url(entity.field_content_upload_image.0.entity.fileuri) %}
        {% elseif entity.field_upload_image.0.entity is not empty %}
          {% set img_url = file_url(entity.field_upload_image.0.entity.fileuri) %}
        {% elseif entity.field_image.0.entity is not empty %}
          {% set img_url = file_url(entity.field_image.0.entity.fileuri) %}
        {% endif %}

        <li class="media-item">
          <a href="{{ link }}" {% if 'node/' not in link and '/' not in link %}target="_blank" rel="noopener noreferrer"{% endif %}>
            {% if img_url is not empty %}
              <div class="media-image-wrapper">
                <img src="{{ img_url }}" alt="{{ tokens['{{ title }}']|striptags|trim }}" />
              </div>
            {% endif %}
            <p>{{ tokens['{{ title }}']|default(entity.label()) }}</p>
          </a>
        </li>
      {% endfor %}
    </ul>
  </div>

  <div class="media-footer text-end">
    <a href="/blogs" class="view-all" aria-label="View all blogs">{% if language == 'hi' %}सभी देखें{% else %}View All{% endif %} <i class="fas fa-arrow-right"></i></a>
  </div>
</div>
