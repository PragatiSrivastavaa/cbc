<div class="carousel" role="region" aria-label="Carousel">
  <div role="status" aria-live="polite" aria-atomic="true">


  {% set first_video_url = '' %}
  
  {# Extract first video URL for the background video element #}
  {% if rows|length > 0 %}
    {% set first_node = rows[0].content['#row']._entity %}
    {% if first_node.field_banner_video.entity is not empty %}
      {% set media = first_node.field_banner_video.entity %}
      {% if media.field_media_video_file.entity is not empty %}
        {% set file = media.field_media_video_file.entity %}
        {% set first_video_url = file_url(file.uri.value) %}
      {% endif %}
    {% endif %}
  {% endif %}

  <video id="bg-video" autoplay muted loop playsinline preload="auto" aria-label="CBC Introduction Video">
    {% if first_video_url %}
      <source src="{{ first_video_url }}" type="video/mp4" />
    {% endif %}
    Your browser does not support the video tag.
  </video>

  <ul class="carousel-track list-unstyled p-0 m-0">
  {% set video_urls = [] %}
  {% for row in rows %}
    {% set node = row.content['#row']._entity %}
    {% set video_url = '' %}

    {# Get video from node media field #}
    {% if node.field_banner_video.entity is not empty %}
      {% set media = node.field_banner_video.entity %}
      {% if media.field_media_video_file.entity is not empty %}
        {% set file = media.field_media_video_file.entity %}
        {% set video_url = file_url(file.uri.value) %}
      {% endif %}
    {% endif %}

    {% set video_urls = video_urls|merge([video_url]) %}

    <li class="slide-content {% if loop.first %}active{% endif %}" id="slide{{ loop.index }}">
    </li>
  {% endfor %}
  </ul>

  <button class="carousel-prev" aria-label="Previous Slide"><i class="fas fa-chevron-left"></i></button>
  <button class="carousel-next" aria-label="Next Slide"><i class="fas fa-chevron-right"></i></button>

  <div class="hero-pause-container">
    <button class="carousel-pause-btn" id="carouselPauseBtn" aria-label="Pause Video and Carousel"><i class="fas fa-pause" aria-hidden="true"></i></button>
  </div>

  {# Move dots to separate container if still needed, or hide them as user didn't ask for them specifically #}
  <ul class="nav-buttons list-unstyled p-0 m-0">
    {% for i in 1..rows|length %}
      <li><button class="{% if i == 1 %}active{% endif %}" data-slide="{{ i }}" {% if i == 1 %}aria-current="true"{% endif %} aria-label="Go to slide {{ i }}"></button></li>
    {% endfor %}
  </ul>

  </div>
</div>

<script type="application/json" id="carousel-video-data">
  {{ video_urls|json_encode|raw }}
</script>