<section class="container py-5">
  <div class="row">
    <div class="col-lg-12">
      <div class="content-section">

        <p class="lead">
          Stay updated with the latest press releases, announcements, and media coverage from the Capacity Building Commission.
        </p>

        <div class="media-releases-list mt-5">

          {% for row in rows %}
            {% set entity = row.content['#row']._entity %}
            {% set link_item = entity.field_link.0 %}

            {# Default values #}
            {% set link = path('entity.node.canonical', {'node': entity.id()}) %}
            {% set link_label = entity.label %}

            {# If link field exists, use it #}
            {% if link_item %}
              {% set link = link_item.url.toString %}
              {% if link_item.title %}
                {% set link_label = link_item.title %}
              {% endif %}
            {% endif %}

            <div class="media-release-item mb-4 p-4 border rounded shadow-sm">
              <h5 class="mb-3">
                <a href="{{ link }}" target="_blank" rel="noopener noreferrer" class="text-decoration-none">
                  {{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ title }}'] }}
                </a>
              </h5>

              <p class="text-muted mb-0">
                <a href="{{ link }}" target="_blank" rel="noopener noreferrer" class="text-decoration-none">
                  {{ link_label }}
                </a>
              </p>
            </div>

          {% endfor %}

        </div>
      </div>
    </div>
  </div>
</section>
