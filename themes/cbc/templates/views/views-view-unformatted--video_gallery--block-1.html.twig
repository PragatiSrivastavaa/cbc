<!-- Video Gallery Section - Right -->
 
            <div class="youtube-section glimpses-card p-3 rounded-4 socil-bg position-relative h-100">
              <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="social-heading d-flex align-items-center gap-2 mb-0">
                  <i class="fa-regular fa-circle-play text-info"></i> {% if language == 'hi' %}वीडियो गैलरी{% else %}Video Gallery{% endif %}
                </h4>
                <div class="d-flex align-items-center gap-3">
                  <div class="carousel-controls d-flex gap-2">
                    <button class="youtube-prev"><i class="fas fa-chevron-left"></i></button>
                    <button class="youtube-pause-btn" id="youtubePauseBtn" aria-label="Pause Video Carousel"><i class="fas fa-pause"></i></button>
                    <button class="youtube-next"><i class="fas fa-chevron-right"></i></button>
                  </div>
                </div>
              </div>

              <div class="youtube-carousel-wrapper position-relative" role="region" aria-label="Carousel">
                <div role="status" aria-live="polite" aria-atomic="true">
                <ul class="youtube-carousel d-flex list-unstyled p-0 m-0" id="youtubeCarousel">

        {% for row in rows %}
          {% set node = row.content['#row']._entity %}
          {% set tokens = row.content['#view'].style_plugin.render_tokens[loop.index0] %}
          {% set video_url = '' %}

          {# Get video file #}
          {% if node.field_video.entity is not empty %}
            {% set media = node.field_video.entity %}
            {% if media.field_media_video_file.entity is not empty %}
              {% set file = media.field_media_video_file.entity %}
              {% set video_url = file_url(file.uri.value) %}
            {% endif %}
          {% endif %}

          <li class="youtube-card high-contrast-border flex-shrink-0 w-100">

            <div class="video-container">
              {% if video_url %}
                <video class="w-100 rounded-3" controls muted preload="metadata" aria-label="Video: {{ node.label }}">
                  <source src="{{ video_url }}" type="video/mp4">
                </video>
              {% endif %}
            </div>

            <div class="video-caption">
              <h4 class="video-title">{{row.content['#view'].style_plugin.render_tokens[ loop.index0 ]['{{ title }}'] }}</h4>
              <p class="video-description">{{row.content['#view'].style_plugin.render_tokens[ loop.index0 ]['{{ field_event_description }}']|striptags|trim }}</p>
            </div>

          </li>

        {% endfor %}

      </ul>
      </div>
    </div>

    <div class="video-gallery-footer text-end">
      <a href="/video-gallery" class="view-all-videos-btn" aria-label="View all videos">
        {% if language == 'hi' %}सभी वीडियो देखें{% else %}View All Videos{% endif %} <i class="fas fa-arrow-right"></i>
      </a>
    </div>

  </div>

<!-- End of Video Gallery Section - Right -->