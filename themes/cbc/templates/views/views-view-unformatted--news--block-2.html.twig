<div class="news-section">

  <!-- Header -->
  <div class="news-header">
    <div class="news-title-wrapper">
      <h2 class="wave-text">
        <!-- <span class="header-new-badge">
          <i class="fas fa-star"></i> NEW
        </span>-->  {% if language == 'hi' %}नया क्या है{% else %}What's New{% endif %}
      </h2>
      <div class="title-underline"></div>
    </div>

    <button class="toggle-slide" id="toggleSlideBtn" title="Pause/Play">
      <i class="fas fa-pause"></i>
    </button>
  </div>

  <!-- News Slider -->
  <div class="news-wrapper high-contrast-border" id="newsWrapper">
    <ul class="news-banner-track list-unstyled p-0 m-0" id="newsTrack">

      {% for row in rows %}
        {% set node = row.content['#row']._entity %}
        {% set entity = row.content['#row']._entity %}
        {% set title_text = row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ title }}'] %}
                   {% set link_item = entity.field_link.0 %}

                {% if link_item %}
                  {# Convert internal/external link to usable URL #}
                  {% set link = link_item.url %}
                {% else %}
                  {# If linked field is empty, link to node page #}
                  {% set link = path('entity.node.canonical', {'node': entity.id()}) %}
                {% endif %}

        {% if node.field_category is not empty
          and node.field_category.entity.label() == "What's New" %}

          <li class="news-banner high-contrast-border">

            {# NEW badge only for today or future dates #}
            {% if node.field_end_date is not empty %}
              {% set start_date = node.field_end_date.0.value|date('Y-m-d') %}
              {% set today = 'now'|date('Y-m-d') %}

              {% if start_date >= today %}
                <!-- <div class="new-badge">
                  <span class="badge-text">NEW</span>
                  <div class="badge-glow"></div>
                </div> -->
              {% endif %}
            {% endif %}

            <div class="news-banner-content">
              <a href="{{ link }}" target="_blank" rel="noopener noreferrer">
                <p>{{ title_text }}</p>
              </a>
            </div>

          </li>

        {% endif %}
      {% endfor %}

    </ul>
  </div>

  <!-- Footer -->
  <div class="news-footer">
    <a href="/whats-new" class="view-all" aria-label="View all what's new">
      {% if language == 'hi' %}सभी देखें{% else %}View All{% endif %} <i class="fas fa-arrow-right"></i>
    </a>
  </div>

</div>
