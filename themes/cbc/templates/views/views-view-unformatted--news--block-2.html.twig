<div class="news-section">

  <!-- Header -->
  <div class="news-header">
    <div class="news-title-wrapper">
      <h2 class="wave-text">
        <img src="{{ base_path ~ directory }}/img/whats_new.gif" alt="What's New" class="whats-new-gif" />
        <span class="blink-dot"></span>What's New
      </h2>
      <div class="title-underline"></div>
    </div>

    <button class="toggle-slide" id="toggleSlideBtn" title="Pause/Play">
      <i class="fas fa-pause"></i>
    </button>
  </div>

  <!-- News Slider -->
  <div class="news-wrapper high-contrast-border" id="newsWrapper">
    <div class="news-banner-track" id="newsTrack">

      {% for row in rows %}
      {% set entity = row.content['#row']._entity %}
        {% set node = row.content['#row']._entity %}
        {% set tokens = row.content['#view'].style_plugin.render_tokens[loop.index0] %}
        {% set category = node.field_category.entity.label() %}

        {% if category == "What's New" %}

          <div class="news-banner high-contrast-border">

            {# NEW badge only for today's or upcoming items #}
            {% set start_date = node.field_start_date.value|date("Y-m-d") %}
            {% set today = "now"|date("Y-m-d") %}

            {% if start_date >= today %}
              <div class="new-badge">
                <span class="badge-text">NEW</span>
                <div class="badge-glow"></div>
              </div>
            {% endif %}

            <div class="news-banner-content">
              <a href="{{ path('entity.node.canonical', {'node': entity.id()}) }}"><p>{{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ title }}'] }}</p></a>
            </div>

          </div>

        {% endif %}
      {% endfor %}

    </div>
  </div>

  <!-- Footer -->
  <div class="news-footer">
    <a href="/whats-new" class="view-all">
      View All <i class="fas fa-arrow-right"></i>
    </a>
  </div>

</div>
