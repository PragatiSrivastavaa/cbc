   
  
  <div class="chairperson-image-card high-contrast-border">
   {% for row in rows %}
              {% set entity = row.content['#row']._entity %}
          <div class="chairperson-image-wrapper">
            {{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ field_image }}'] }}
            <div class="chairperson-overlay">
              <p>{{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ field_event_description }}'] }}</p>
              <a href="pages/leadership.html" class="view-more">View More →</a>
            </div>
          </div>
          <div class="chairperson-content">
            <h3>{{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ title }}'] }}</h3>
            <p class="chairperson-designation">{{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ field_team_members }}'] }}</p>
          </div>
		    {% endfor %}
        </div>
