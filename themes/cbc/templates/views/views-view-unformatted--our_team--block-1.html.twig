   
  
  
<div class="leadership-members-row">
{% for row in rows %}
  {% set role_text = row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ field_team_members }}']|striptags|trim|upper %}
  {% set is_ps_pps = ('PS' in role_text) %}
  <div class="chairperson-image-card high-contrast-border {{ is_ps_pps ? 'is-ps-pps' : '' }}">
             {% set entity = row.content['#row']._entity %}
         <div class="chairperson-image-wrapper">
           {{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ field_image }}'] }}
           <div class="chairperson-overlay">
             <p>
             {{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ field_event_description }}']|striptags|trim }}</p>
             <a href="{{ path('entity.node.canonical', {'node': entity.id()}) }}" class="view-more">View More →</a>
             
           </div>
         </div>
         <div class="chairperson-content">
           <h3>{{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ title }}'] }}</h3>
           <p class="chairperson-designation">{{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ field_team_members }}'] }}</p>
         </div>
         </div>
		    {% endfor %}
</div>
