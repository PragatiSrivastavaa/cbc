<section class="container py-5">
  <div class="row">
    <div class="col-lg-12">
      <div class="content-section">
        <div class="table-responsive">
          <table class="table table-bordered table-hover tenders-table">
            <thead>
              <tr>
                <th>S. No</th>
                <th>Tender Ref. No.</th>
                <th>Tender Title</th>
                <th>Date of Publish</th>
                <th>Last Date of Submission</th>
                <th>Documents</th>
              </tr>
            </thead>
            <tbody>

              {% for row in rows %}
                {% set node = row.content['#row']._entity %}

                <tr>
                  <td>{{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ field_sequence_no }}'] }}</td>
                  <td>{{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ title }}'] }}</td>
                  <td>{{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ field_tender_title }}'] }}</td>
                  <td>{{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ field_date_of_nit }}'] }}</td>
                  <td>{{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ field_date_of_submission }}'] }}</td>
                  <td>
                    {% set node = row.content['#row']._entity %}
                    {% if loop.last %}
                      {% if node.field_tender_related_files is not empty %}
                        <div class="view view-tender view-id-tender view-display-id-block_2 js-view-dom-id">
                          <div class="view-content">
                            {% for item in node.field_tender_related_files %}
                              {% set paragraph = item.entity %}
                              {% if paragraph and paragraph.field_upload_document_file.entity %}
                                {% set file = paragraph.field_upload_document_file.entity %}
                                {% set label = paragraph.field_upload_document_file[0].description|default('View Document') %}
                                {% set language = paragraph.field_document_language.value|upper %}
                                {% set extension = file.filename.value|split('.')|last|upper %}
                                {% set size = file.filesize.value is not empty ? file.filesize.value|format_size : 'Unknown' %}

                                <div class="views-row">
                                  <div class="views-field views-field-field-upload-document-file">
                                    <div class="field-content">
                                      <a href="{{ file_url(file.uri.value) }}" target="_blank" tabindex="-1">{{ label }}</a>
                                      (<strong>Format</strong>: {{ extension }} , <strong>Size</strong>: {{ size }} , <strong>Language</strong>: {{ language }})
                                    </div>
                                  </div>
                                </div>

                              {% endif %}
                            {% endfor %}
                          </div>
                        </div>
                      {% else %}
                        -
                      {% endif %}
                    {% else %}
                      {{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ field_tender_related_files }}'] }}
                    {% endif %}
                  </td>

                </tr>

              {% endfor %}

            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</section>
