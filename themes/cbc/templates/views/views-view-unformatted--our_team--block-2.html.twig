
<div class="meet-team-section-enhanced py-5">
        <div class="container">
          <div class="karmayogi-content-wrapper">
            <div class="row">
              <div class="col-12">
                <div class="document-section-header mb-5">
                  <h2 class="section-title">Meet Our Team</h2>
                  <div class="title-underline"></div>
                </div>
              </div>
            </div>

            <!-- Leadership -->
            <div class="row mb-5">
              <div class="col-12">
                <div class="team-category">
                  <h3 class="team-category-title mb-4">Leadership</h3>
                  <div class="row g-4">

                    {% for row in rows %}
              {% set entity = row.content['#row']._entity %}
                    <div class="col-lg-4 col-md-4 col-sm-6">
                      <div class="team-member-card no-overlay-card">
                        <div class="team-member-image">
                          {{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ field_image }}'] }}
                        </div>
                        <div class="team-member-info">
                          <h4 class="team-member-name">{{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ title }}'] }}</h4>
                          <p class="team-member-role">{{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ field_team_members }}'] }}</p>
                          <p class="team-member-contact"><i class="fas fa-phone"></i>{{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ field_phone }}'] }}</p>
                          <p class="team-member-contact"><i class="fas fa-envelope"></i> {{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ field_email }}'] }}</p>
                          <a href="{{ path('entity.node.canonical', {'node': entity.id()}) }}" class="view-more">View More →</a>
                        </div>
                      </div>
                    </div>
                    {% endfor %}


                  </div>
                </div>
              </div>
            </div>

           
          </div>
        </div>
      </div>

