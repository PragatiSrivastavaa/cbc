<div class="collab-content-wrapper">
          <div class="collab-carousel" role="region" aria-label="Carousel">


            <ul class="collab-track list-unstyled m-0" id="collabTrack">
              {% for row in rows %}
              {% set entity = row.content['#row']._entity %}
              {% set tokens = row.content['#view'].style_plugin.render_tokens[loop.index0] %}
              <li class="collab-item">
                <a href="{{ path('entity.node.canonical', {'node': entity.id()}) }}">
                  <div class="collab-box high-contrast-border">
                  {% if entity.field_image is not empty and entity.field_image.0.entity %}
                  {% set file = entity.field_image.0.entity %}
                  {% set img_url = file_url(file.fileuri) %}

                  <img src="{{ img_url }}" class="collab-image" alt="">
                {% endif %}
                
                  <h3>{{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ title }}']|striptags }}</h3>
                  <div class="collab-description">{{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ body }}']|striptags }}{{row.content['#view'].style_plugin.render_tokens[ loop.index0 ]['{{ field_event_description }}']|striptags }}</div>
                </div>
                </a>
              </li>
              {% endfor %}
            </ul>
          </div>
        </div>
        <div class="collab-footer">
          <div class="collab-controls">
            <button class="collab-arrow" id="collabPrevBtn" aria-label="Previous"><i class="fas fa-chevron-left"></i></button>
            <button class="collab-arrow collab-pause-btn" id="collabPauseBtn" aria-label="Pause Collaboration Carousel"><i class="fas fa-pause" aria-hidden="true"></i></button>
            <button class="collab-arrow" id="collabNextBtn" aria-label="Next"><i class="fas fa-chevron-right"></i></button>
          </div>
          <a href="/collaborations" class="view-more" aria-label="View all collaborations">{% if language == 'hi' %}और देखें{% else %}View More{% endif %} <i class="fas fa-arrow-right"></i></a>
        </div>