<div class="collab-content-wrapper">
          <button class="collab-arrow left" id="collabPrevBtn" aria-label="Previous">❮</button>
          <div class="collab-carousel" role="region" aria-label="Carousel">


            <div class="collab-track" id="collabTrack" role="status" aria-live="polite" aria-atomic="true">
              {% for row in rows %}
              {% set entity = row.content['#row']._entity %}
              {% set tokens = row.content['#view'].style_plugin.render_tokens[loop.index0] %}
              <a href="{{ path('entity.node.canonical', {'node': entity.id()}) }}">
                <div class="collab-box high-contrast-border">
                {% if entity.field_image is not empty and entity.field_image.0.entity %}
        {% set file = entity.field_image.0.entity %}
        {% set img_url = file_url(file.fileuri) %}

        <img src="{{ img_url }}" class="collab-image" alt="{{ tokens['{{ title }}'] }}">
      {% endif %}
               
                <h3>{{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ title }}'] }}</h3>
                <div class="collab-description">{{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ body }}'] }}{{row.content['#view'].style_plugin.render_tokens[ loop.index0 ]['{{ field_event_description }}'] }}</div>
              </div>
              </a>
              {% endfor %}
            </div>


          </div>
          <button class="collab-arrow right" id="collabNextBtn" aria-label="Next">❯</button>
        </div>
        <div class="collab-footer">
          <a href="/collaborations" class="view-more">View More <i class="fas fa-arrow-right"></i></a>
        </div>