<div class="carousel-track" id="opinionCarouselTrack">

 {% for row in rows %}
              {% set entity = row.content['#row']._entity %}

        <div class="blog-card">
          {{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ field_image }}'] }}
          <div class="blog-card-content">
            <h3>{{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ title }}'] }}</h3>
            <p>{{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ field_event_description }}'] }}</p>
          </div>
          <a href="{{ path('entity.node.canonical', {'node': entity.id()}) }}" class="opinion-card-link">Read More →</a>
        </div>
        {% endfor %}
      </div>
