

              <div class="section-header media-header-bg">
                <h3 class="section-header-title">{% if language == 'hi' %}मीडिया कॉर्नर{% else %}MEDIA CORNER{% endif %}</h3>
                <div class="section-header-controls">
                  <button class="toggle-slide" id="toggleMediaSlideBtn" title="Pause/Play">
                    <i class="fas fa-pause"></i>
                  </button>
                </div>
              </div>
              <div class="section-body">
                <div class="media-corner-box high-contrast-border position-relative" role="region" aria-label="Carousel">
                  <ul class="media-track list-unstyled p-0 m-0" id="mediaTrack">
                    {% for row in rows %}
                    {% set entity = row.content['#row']._entity %}
                   {% set link_item = entity.field_link.0 %}

                {% if link_item %}
                  {# Convert internal/external link to usable URL #}
                  {% set link = link_item.url %}
                {% else %}
                  {# If linked field is empty, link to node page #}
                  {% set link = path('entity.node.canonical', {'node': entity.id()}) %}
                {% endif %}
                    <li class="media-item">
                      <a href="{{ link }}" target="_blank"
                        rel="noopener noreferrer">
                        <div class="media-image-wrapper">
                          {{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ field_image }}'] }}
                        </div>
                        <p>{{ row.content['#view'].style_plugin.render_tokens[loop.index0]['{{ title }}'] }}</p>
                      </a>
                    </li>

                    {% endfor %}
                  </ul>
                </div>

                <div class="media-footer text-end">
                  <a href="/media-corner" class="view-all" aria-label="View all media corner">{% if language == 'hi' %}सभी देखें{% else %}View All{% endif %} <i class="fas fa-arrow-right"></i></a>
                </div>
              </div>