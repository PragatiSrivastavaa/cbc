<!-- Opinions Do Matter Section -->
<section class="karmayogi-section-fullwidth opinions-grid-section">
  <div class="container">
    <div class="row g-3">
      {% for row in rows %}
        {% set entity = row.content['#row']._entity %}
        {% set tokens = row.content['#view'].style_plugin.render_tokens[loop.index0] %}

        <div class="col-lg-3 col-md-6">
          <div class="opinion-card">
            {% if tokens['{{ field_image }}'] %}
              <div class="opinion-card-image">
                {{ tokens['{{ field_image }}'] }}
              </div>
            {% endif %}
            <div class="opinion-card-content">
              <h3 class="opinion-card-title">{{ tokens['{{ title }}'] }}</h3>
              {% if tokens['{{ field_author }}'] %}
                <p class="opinion-card-author">{{ tokens['{{ field_author }}'] }}</p>
              {% endif %}
              {% if tokens['{{ field_designation }}'] %}
                <p class="opinion-card-designation">{{ tokens['{{ field_designation }}'] }}</p>
              {% endif %}
              {% if tokens['{{ field_event_description }}'] %}
                <div class="opinion-card-description">
                  {{ tokens['{{ field_event_description }}'] }}
                </div>
              {% endif %}
              <a href="{{ path('entity.node.canonical', {'node': entity.id()}) }}" class="opinion-card-link" aria-label="Read more about {{ tokens['{{ title }}']|striptags|trim }}">
                Read More <i class="fas fa-arrow-right"></i>
              </a>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>