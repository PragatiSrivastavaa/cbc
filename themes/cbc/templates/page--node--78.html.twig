{% include 'themes/cbc/templates/layout/header.html.twig' %}

<main id="app-content">
     <!-- Hero Section -->

       {% if content.field_hero_section %}
       {{ content.field_hero_section }}
       {% else %}
  <div class="page-hero-section">
  <div class="page-hero-overlay"></div>
  <div class="container">
    <div class="row">
      <div class="col-12 text-center">
        <h1 class="page-hero-title">{{ page.page_title }}</h1>
        <p class="page-hero-subtitle"> {{ page.view_header|raw }}</p>
      </div>
    </div>
  </div>
</div>
       {% endif %}
    <!-- Breadcrumb Section -->
    {{ page.breadcrumb }}

    <section class="events-page-container">
      <div class="container-fluid px-4 py-5">

        <!-- Search and Filter Section -->
        <div class="events-search-section mb-4">
          <div class="row g-3 align-items-end">
            <div class="col-md-4">
            <div class="view-toggle-buttons mt-3">
            <button class="view-toggle-btn " id="calendarViewBtn">
             <i class="fas fa-calendar-alt"></i> Calendar View
              </button>
             <button class="view-toggle-btn active" id="listViewBtn">
             <i class="fas fa-list"></i> List View
            </button>
            </div>
           </div>
          </div>
        </div>

       
    <!-- Calendar View -->
    <div id="calendarView" style="display:none;">
      {{ drupal_view('events', 'page_2') }}
    </div>

    <!-- List View -->
    <div id="listView">
      {{ drupal_view('events', 'page_1') }}
    </div>
      </div>
    </section>
  </main>


{% include 'themes/cbc/templates/layout/footer.html.twig' %}

<script>
document.addEventListener('DOMContentLoaded', () => {
  const calendarBtn = document.getElementById('calendarViewBtn');
  const listBtn = document.getElementById('listViewBtn');
  const calendarView = document.getElementById('calendarView');
  const listView = document.getElementById('listView');

  function switchView(view) {
    calendarView.style.display = view === 'calendar' ? 'block' : 'none';
    listView.style.display = view === 'list' ? 'block' : 'none';

    calendarBtn.classList.toggle('active', view === 'calendar');
    listBtn.classList.toggle('active', view === 'list');

    // Fix FullCalendar render when visible
    if (view === 'calendar') {
      setTimeout(() => window.dispatchEvent(new Event('resize')), 200);
    }
  }

  calendarBtn.addEventListener('click', () => switchView('calendar'));
  listBtn.addEventListener('click', () => switchView('list'));
});
</script>
