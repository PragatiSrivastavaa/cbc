            {% if page.messages %}
            <div class="messages-area">{{ page.messages }}</div>
            {% endif %}
        </div>

        {# This renders the Basic Page body field containing our custom landing page HTML #}
        <script>
            (function () {
                /* Find the base URL of the cbc theme by looking at any already-loaded
                   theme stylesheet (e.g. home.css loaded by Drupal globally). */
                function getThemeBase() {
                    var links = document.querySelectorAll('link[rel="stylesheet"]');
                    for (var i = 0; i < links.length; i++) {
                        var href = links[i].href || '';
                        var idx = href.indexOf('/themes/cbc/');
                        if (idx !== -1) { return href.substring(0, idx); }
                    }
                    /* Fallback: derive from current page URL up to the Drupal root.
                       Works if Drupal is at a subdirectory like /cbc/ or at / */
                    var base = window.location.origin;
                    var path = window.location.pathname;
                    var drupalRoot = path.split('/themes/')[0];
                    return base + (drupalRoot || '');
                }
                var base = getThemeBase();
                var theme = base + '/themes/cbc';
                /* Inject CSS — skip if already loaded */
                if (!document.querySelector('link[href*="sadhana-saptah.css"]')) {
                    var css = document.createElement('link');
                    css.rel = 'stylesheet';
                    css.type = 'text/css';
                    css.href = theme + '/css/sadhana-saptah.css';
                    document.head.appendChild(css);
                }
                /* Inject Google Fonts — skip if already loaded */
                if (!document.querySelector('link[href*="Outfit"]')) {
                    var gf = document.createElement('link');
                    gf.rel = 'stylesheet';
                    gf.href = 'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@400;500;600;700;800&display=swap';
                    document.head.appendChild(gf);
                }
                /* Inject JS after DOM is ready — skip if already loaded */
                function loadJS() {
                    if (document.querySelector('script[src*="sadhana-saptah.js"]')) return;
                    var scr = document.createElement('script');
                    scr.src = theme + '/js/sadhana-saptah.js';
                    document.body.appendChild(scr);
                }
                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', loadJS);
                } else {
                    loadJS();
                }
            })();
        </script>
