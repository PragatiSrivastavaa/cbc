                                                                         block below and paste it.
                                                                                    -->
                            <div class="swiper videoSwiper">
                                <div class="swiper-wrapper">
                                    <!-- ★ DYNAMIC VIDEO CAROUSEL VIA TWIG TWEAK ('video_gallery', 'page_2') ★ -->
                                    {% set video_view_results = drupal_view_result('video_gallery', 'page_2') %}
                                    {% if video_view_results is not empty %}
                                    {% for row in video_view_results %}
                                    {% set entity = row._entity %}
                                    {% if entity.field_video is not empty %}
                                    {% for video_item in entity.field_video %}
                                    {% if video_item.entity and video_item.entity.field_media_video_file is not empty %}
                                    <div class="swiper-slide">
                                        <div class="video-container" style="height:100% !important;">
                                            <video
                                                style="height:100% !important;object-fit:cover !important;width:100% !important;"
                                                controls playsinline>
                                                <source
                                                    src="{{ file_url(video_item.entity.field_media_video_file.entity.fileuri) }}"
                                                    type="video/mp4">
                                            </video>
                                        </div>
                                    </div>
                                    {% endif %}
                                    {% endfor %}
                                    {% endif %}
                                    {% endfor %}
                                    {% else %}
                                    <!-- Fallback Video -->
                                    <div class="swiper-slide">
                                        <div class="video-container" style="height:100% !important;">
                                            <video
                                                style="height:100% !important;object-fit:cover !important;width:100% !important;"
                                                controls playsinline>
                                                <source
                                                    src="/sites/default/files/2026-03/WhatsApp%20Video%202026-03-31%20at%2011.45.51%20AM%20%281%29.mp4"
                                                    type="video/mp4">
                                            </video>
                                        </div>
                                    </div>
                                    {% endif %}
                                </div>
                                <!-- /swiper-wrapper -->
                                <div class="swiper-pagination">
                                    &nbsp;
                                </div>
