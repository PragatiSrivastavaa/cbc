{#
/**
 * @file
 * Theme override for an 'input' #type form element.
 *
 * Available variables:
 * - attributes: A list of HTML attributes for the input element.
 * - children: Optional additional rendered elements.
 *
 * @see template_preprocess_input()
 */
#}
{# Logic to handle autocomplete attribute in template #}
{% set type = attributes.type|default('text') %}
{% set allowed_autocomplete = ['color', 'date', 'datetime-local', 'email', 'hidden', 'month', 'number', 'password', 'range', 'search', 'tel', 'text', 'time', 'url', 'week'] %}

{% if type in allowed_autocomplete %}
  {% if not attributes.offsetExists('autocomplete') %}
     {# Default to autocomplete="off" for valid types if not set #}
     <input{{ attributes.setAttribute('autocomplete', 'off') }} />
  {% else %}
     <input{{ attributes }} />
  {% endif %}
{% else %}
  {# For invalid types (submit, etc), ensure autocomplete is NOT present #}
  <input{{ attributes|without('autocomplete') }} />
{% endif %}
{{ children }}
