{% include 'themes/cbc/templates/layout/header.html.twig' %}
{{ attach_library('cbc/training-institutes-map') }}

<main id="app-content">
     <!-- Hero Section -->

       {% if content.field_hero_section %}
       {{ content.field_hero_section }}
       {% else %}
  <div class="page-hero-section">
  <div class="page-hero-overlay"></div>
  <div class="container">
    <div class="row">
      <div class="col-12 text-center">
        <h1 class="page-hero-title">{{ page.page_title }}</h1>
        <p class="page-hero-subtitle"> {{ page.view_header|raw }}</p>
      </div>
    </div>
  </div>
</div>
       {% endif %}
    <!-- Breadcrumb Section -->
    {{ page.breadcrumb }}
	
	 

  <section class="training-institutes-map-section">
    <div class="container mt-5 mb-5">
	 <div class="mb-5 pdf-links-section">
                   <h2 class="mb-5" style="background-color:#ff9e0f;border-radius:8px;color:white;margin-bottom:30px;padding:15px 20px;text-align:center;">
        <a style="color:#ffffff;" href="/accreditation-qips"><strong>Click Here For Accreditation</strong></a>
        </h2>
                </div>
      <div class="training-institutes-map-wrapper" role="region" aria-label="Interactive map of CTIs and ATIs">
        <div id="training-institutes-map" aria-live="polite"></div>
      </div>
    </div>
  </section>
</main>

{% include 'themes/cbc/templates/layout/footer.html.twig' %}


