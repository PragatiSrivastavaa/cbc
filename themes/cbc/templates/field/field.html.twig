{#
/**
 * @file
 * Theme override for a field.
 *
 * Use this as a fallback cleaner for all fields to strip legacy W3C attributes.
 */
#}
{%
  set classes = [
    'field',
    'field--name-' ~ field_name|clean_class,
    'field--type-' ~ field_type|clean_class,
    'field--label-' ~ label_display,
    label_display == 'inline' ? 'clearfix',
  ]
%}
{%
  set title_classes = [
    'field__label',
    label_display == 'visually_hidden' ? 'visually-hidden',
  ]
%}
{# Define W3C HTML cleanup replacements #}
{% set w3c_replacements = {
  'frameborder="0"': '', 'frameborder=\'0\'': '',
  'frameborder="1"': '', 'frameborder=\'1\'': '',
  'scrolling="no"': '', 'scrolling=\'no\'': '',
  'scrolling="yes"': '', 'scrolling=\'yes\'': '',
  'scrolling="auto"': '', 'scrolling=\'auto\'': '',
  'align="center"': '', 'align=\'center\'': '',
  'align="left"': '', 'align=\'left\'': '',
  'align="right"': '', 'align=\'right\'': '',
  'align="middle"': '', 'align=\'middle\'': '',
  'align="justify"': '', 'align=\'justify\'': '',
  'border="0"': '', 'border=\'0\'': '',
  'cellpadding="0"': '', 'cellpadding=\'0\'': '',
  'cellspacing="0"': '', 'cellspacing=\'0\'': '',
  'allowtransparency="true"': '', 'allowtransparency=\'true\'': ''
} %}

{% if label_hidden %}
  {% if multiple %}
    <div{{ attributes.addClass(classes, 'field__items') }}>
      {% for item in items %}
        <div{{ item.attributes.addClass('field__item') }}>{{ item.content|render|replace(w3c_replacements)|raw }}</div>
      {% endfor %}
    </div>
  {% else %}
    {% for item in items %}
      <div{{ attributes.addClass(classes, 'field__item') }}>{{ item.content|render|replace(w3c_replacements)|raw }}</div>
    {% endfor %}
  {% endif %}
{% else %}
  <div{{ attributes.addClass(classes) }}>
    <div{{ title_attributes.addClass(title_classes) }}>{{ label }}</div>
    {% if multiple %}
      <div class="field__items">
    {% endif %}
    {% for item in items %}
      <div{{ item.attributes.addClass('field__item') }}>{{ item.content|render|replace(w3c_replacements)|raw }}</div>
    {% endfor %}
    {% if multiple %}
      </div>
    {% endif %}
  </div>
{% endif %}
