<section class="container py-5">
  <div class="row">
    <div class="col-lg-10 mx-auto">
      <div class="content-section collab-detail-content">

        {# Original image (no image style) #}
        {% if node.field_image.entity %}
          <div class="text-center mb-4">
            <div class="event-article-content">
              <img
                src="{{ file_url(node.field_image.entity.fileuri) }}"
                alt="{{ node.field_image.alt }}"
                loading="eager"
                class="img-fluid"
              >
            </div>
          </div>
        {% endif %}

        <h1 class="collab-detail-title">{{ node.label }}</h1>

        {% if node.field_event_description.value %}
          <div class="collab-detail-text">
            <div class="event-article-content">
              {{ content.field_event_description }}
            </div>
          </div>
        {% endif %}

      </div>
    </div>
  </div>
</section>
