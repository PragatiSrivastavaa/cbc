{#
/**
 * Template override for Blogs detail page (bundle: blogs)
 */
#}
{% set img_entity = node.field_upload_image.0.entity|default(node.field_content_upload_image.0.entity)|default(node.field_image.0.entity) %}
{% set file_entity = node.field_upload_file.0.entity|default(node.field_content_upload_file.0.entity)|default(node.field_file.0.entity) %}
{% set url_val = node.field_url.0.url|default(node.field_url.0.uri)|default(node.field_content_url.0.url)|default(node.field_content_url.0.uri) %}

<section class="opinion-detail-page block-section-detail-page py-4">
  <div class="container">
    <div class="row">
      <div class="col-lg-10 offset-lg-1">

        <!-- White Main Content Card -->
        <div class="opinion-content-card bg-white p-4 p-md-5 rounded shadow-sm">

          {# Featured Banner Image #}
          {% if img_entity %}
            <div class="block-detail-featured-image text-center mb-4 overflow-hidden rounded">
              <img
                src="{{ file_url(img_entity.fileuri) }}"
                alt="{{ node.label }}"
                loading="eager"
                class="img-fluid rounded w-100"
                style="max-height: 480px; object-fit: cover; object-position: center;"
              >
            </div>
          {% endif %}

          {# Title #}
          <h1 class="opinion-article-title text-primary fw-bold mb-3">{{ node.label }}</h1>
          <hr class="opinion-title-separator my-3">

          {# Main Article Content / Description #}
          {% if node.field_description.value is not empty %}
            <div class="opinion-article-content fs-5 text-secondary leading-relaxed mb-4">
              {{ content.field_description }}
            </div>
          {% elseif content.body is not empty %}
            <div class="opinion-article-content fs-5 text-secondary leading-relaxed mb-4">
              {{ content.body }}
            </div>
          {% endif %}

          {# Document Attachment download button #}
          {% if file_entity %}
            <div class="my-4 p-3 bg-light rounded border d-inline-block">
              <i class="fas fa-file-pdf text-danger fs-4 me-2"></i>
              <a href="{{ file_url(file_entity.fileuri) }}" target="_blank" rel="noopener noreferrer" class="fw-bold text-decoration-none me-3">
                {% if language == 'hi' %}दस्तावेज़ डाउनलोड करें / देखें{% else %}View / Download Document{% endif %}
              </a>
            </div>
          {% endif %}

          {# External Link Button #}
          {% if url_val %}
            <div class="my-3">
              <a href="{{ url_val }}" target="_blank" rel="noopener noreferrer" class="btn btn-outline-primary rounded-pill px-4 py-2">
                <i class="fas fa-external-link-alt me-2"></i>
                {% if language == 'hi' %}लिंक पर जाएं{% else %}Visit Link{% endif %}
              </a>
            </div>
          {% endif %}

          {# Back Button #}
          <div class="mt-4 pt-3 border-top">
            <a href="javascript:history.back()" class="btn btn-secondary rounded-pill px-4">
              <i class="fas fa-arrow-left me-2"></i>{% if language == 'hi' %}वापस जाएं{% else %}Back{% endif %}
            </a>
          </div>

        </div>
      </div>
    </div>
  </div>
</section>
