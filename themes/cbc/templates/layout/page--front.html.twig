{% include 'themes/cbc/templates/layout/header.html.twig' %}

  <!-- Main Content Container -->
  <main id="app-content">
    <h1 class="visually-hidden">Capacity Building Commission</h1>

    <!-- slider section -->

     <section>
        {{ page.banner_section }}
    </section>

    <!-- Alert Bar Section -->
    <div class="alert-bar-container">
      <div class="alert-bar-content">
        <!-- <div class="alert-label">
        <i class="fas fa-exclamation-circle"></i>
        <span>Alert</span>
      </div> -->

        {{ page.alerts }}
        <div class="alert-controls">
        <button class="alert-control-btn" id="alertPrevBtn" title="Previous" aria-label="Previous Alert">
          <i class="fas fa-chevron-left" aria-hidden="true"></i>
        </button>
        <button class="alert-control-btn" id="alertPauseBtn" title="Pause/Play" aria-label="Pause or Play Alerts">
