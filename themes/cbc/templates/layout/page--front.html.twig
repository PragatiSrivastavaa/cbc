          <!-- Jitender Ji Section -->
          <div class="col-lg-4">
            <div class="jitender-card">
              {{ page.jitender_content }}
            </div>
          </div>
          
          <!-- What's New Card -->
          <div class="col-lg-5">
            <div class="whts-box">
              {{ page.what_s_news }}
            </div>
          </div>
          
          <!-- In Focus Card -->
          <div class="col-lg-3">
            <div class="infocus-container">
              {{ page.in_focus }}
            </div>
          </div>
