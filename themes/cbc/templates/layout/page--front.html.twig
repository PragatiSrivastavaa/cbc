 {% include 'themes/cbc/templates/layout/footer.html.twig' %}

  <!-- Twitter Widget Script -->
  <script async src="https://platform.twitter.com/widgets.js" charset="utf-8"></script>

  <!-- LinkedIn Widget Script -->
  <script src="https://platform.linkedin.com/in.js" type="text/javascript" data-lang="en_US"></script>


  <!-- Video Testimonials Auto-Carousel Library -->
  {{ attach_library('cbc/video-carousel') }}

  <!-- Initialize Twitter Widget -->
  <script>
    // Ensure Twitter timeline loads after widgets.js is ready
    window.addEventListener('load', function () {
      if (window.twttr && window.twttr.ready) {
        window.twttr.ready(function () {
          window.twttr.widgets.load();
        });
      } else {
        // Poll until twttr is available
        var checkInterval = setInterval(function () {
          if (window.twttr && window.twttr.ready) {
            window.twttr.ready(function () {
              window.twttr.widgets.load();
            });
            clearInterval(checkInterval);
          }
        }, 100);

        // Stop checking after 10 seconds
        setTimeout(function () {
          clearInterval(checkInterval);
        }, 10000);
      }
    });
  </script>