<section class="team-detail-page">
  <div class="container">
    <div class="row">
      <div class="col-lg-10 offset-lg-1">
        <div class="team-detail-wrapper">
          <div class="team-detail-header">
            {% if node.field_image is defined and not node.field_image.isEmpty() %}
			
              <div class="team-detail-photo">
                <img
                src="{{ file_url(node.field_image.entity.fileuri) }}"
                alt="{{ node.field_image.alt }}"
                loading="eager"
                class="img-fluid"
              >
              </div>
            {% endif %}

            <div class="team-detail-info">
              <h1 class="team-detail-name">{{ node.label }}</h1>
			  {% if node.field_piller_content is defined and not node.field_piller_content.isEmpty() %}
  <div class="team-detail-piller">
    {{ content.field_piller_content }}
  </div>
{% endif %}

              {% if node.field_team_members.value %}
                <p class="team-detail-role">
                  {{ node.field_team_members.entity.name.value }}
                </p>
              {% endif %}

              <div class="team-detail-contact">
                {% if node.field_email.value %}
                  <div class="contact-item contact-email">
                    {{ content.field_email }}
                  </div>
                {% endif %}

                {% if node.field_phone.value %}
                  <div class="contact-item contact-phone">
                    {{ content.field_phone }}
                  </div>
                {% endif %}

                {% if node.field_address.value %}
                  <div class="contact-item contact-address">
                    {{ content.field_address }}
                  </div>
                {% endif %}
              </div>
            </div>
          </div>

          {% if node.field_event_description.value %}
            <div class="team-detail-bio">
              {{ content.field_event_description }}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>