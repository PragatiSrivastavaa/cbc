<header>
<!-- Top Bar -->
<div class="top-bar">
  <div class="container-fluid d-flex justify-content-between align-items-center flex-wrap px-3">
    <div class="d-flex align-items-center">
      <a href="#app-content">Skip to main content</a>
      <a class="header-border" href="/screen-reader-access" title="Screen Reader Access Information">Screen Reader</a>
       <!-- Language Toggle -->
  <div class="language-toggle">
          <ul>
          <li class="lang-select">
								{{ page.language }}
					</li></ul>
        </div> 
    </div>
   
    <div class="d-flex align-items-center mt-2 mt-md-0">
      <img src="{{ base_path }}themes/cbc/img/accessability.png" alt="Accessibility Options - Click to Open" class="access-icon" role="button" tabindex="0" title="Open Accessibility Options (Alt+A)" />
      <div class="search-wrapper">
        {{ page.search_section }}
        <!-- <i class="bi bi-search"></i> -->
      </div>
    </div>
  </div>
</div>

<!-- Navbar -->
 {{ page.primary_menu }}
</header>
  <!-- Accessibility Drawer -->
  <div class="accessibility-drawer" id="accessibilityDrawer" role="dialog" aria-label="Accessibility Options" aria-modal="true" data-state="closed">
    <div class="accessibility-header">
      <h2><i class="fas fa-universal-access"></i> Accessibility Options</h2>
      <button class="accessibility-close-btn" id="closeAccessibilityBtn" aria-label="Close Accessibility Menu">
        <i class="fas fa-times"></i>
      </button>
    </div>
    <div class="accessibility-content">
      <div class="accessibility-section">
        <h3><i class="fas fa-text-height"></i> Text Size</h3>
        <div class="text-size-controls">
          <button class="text-size-btn high-contrast-border" data-size="small" aria-label="Small Text Size" aria-pressed="false"><span>A-</span></button>
          <button class="text-size-btn high-contrast-border" data-size="normal" aria-label="Normal Text Size" aria-pressed="true"><span>A</span></button>
          <button class="text-size-btn high-contrast-border" data-size="large" aria-label="Large Text Size" aria-pressed="false"><span>A+</span></button>
          <button class="text-size-btn high-contrast-border" data-size="extra-large" aria-label="Extra Large Text Size" aria-pressed="false"><span>A++</span></button>
        </div>
      </div>

      <div class="accessibility-section">
        <h3><i class="fas fa-adjust"></i> Display Themes</h3>
        <div class="contrast-themes">
          <button class="contrast-btn high-contrast-border" data-theme="default" aria-label="Default Theme" aria-pressed="true">
            <span class="contrast-preview high-contrast-border default">Aa</span>
            <span class="contrast-name">Normal</span>
          </button>
          <button class="contrast-btn high-contrast-border" data-theme="high-contrast" aria-label="High Contrast Theme" aria-pressed="false">
            <span class="contrast-preview high-contrast">Aa</span>
            <span class="contrast-name">High Contrast</span>
          </button>
          <button class="contrast-btn high-contrast-border" data-theme="dark" aria-label="Dark Mode Theme" aria-pressed="false">
            <span class="contrast-preview dark-mode">Aa</span>
            <span class="contrast-name">Dark Mode</span>
          </button>
          <button class="contrast-btn high-contrast-border" data-theme="yellow-black" aria-label="Yellow Black Theme" aria-pressed="false">
            <span class="contrast-preview yellow-black">Aa</span>
            <span class="contrast-name">Yellow-Black</span>
          </button>
        </div>
      </div>

      <div class="accessibility-section">
        <h3><i class="fas fa-mouse-pointer"></i> Cursor Size</h3>
        <div class="cursor-size-controls">
          <div class="cursor-size-option high-contrast-border" data-cursor="normal" role="button" tabindex="0" aria-pressed="true">
            <span class="cursor-label">Normal Cursor</span>
            <div class="cursor-demo normal">●</div>
          </div>
          <div class="cursor-size-option high-contrast-border" data-cursor="large" role="button" tabindex="0" aria-pressed="false">
            <span class="cursor-label">Large Cursor</span>
            <div class="cursor-demo large">●</div>
          </div>
          <div class="cursor-size-option high-contrast-border" data-cursor="extra-large" role="button" tabindex="0" aria-pressed="false">
            <span class="cursor-label">Extra Large Cursor</span>
            <div class="cursor-demo extra-large">●</div>
          </div>
        </div>
      </div>

      <div class="accessibility-section">
  <h3><i class="fas fa-eye"></i> Visual Adjustments</h3>

  <div class="accessibility-toggle-group">

    <div class="accessibility-toggle high-contrast-border"
         role="switch"
         tabindex="0"
         aria-checked="false"
         aria-label="Hide Images"
         data-feature="hide-images"
         data-state="off">

      <span class="toggle-label">
        <i class="fas fa-image"></i> Hide Images
      </span>

      <!-- visual only -->
      <span class="toggle-switch high-contrast-border" aria-hidden="true"></span>
    </div>

    <div class="accessibility-toggle high-contrast-border"
         role="switch"
         tabindex="0"
         aria-checked="false"
         aria-label="Highlight Links"
         data-feature="highlight-links"
         data-state="off">

      <span class="toggle-label">
        <i class="fas fa-link"></i> Highlight Links
      </span>

      <span class="toggle-switch high-contrast-border" aria-hidden="true"></span>
    </div>

    <div class="accessibility-toggle high-contrast-border"
         role="switch"
         tabindex="0"
         aria-checked="false"
         aria-label="Increase Line Height"
         data-feature="increased-line-height"
         data-state="off">

      <span class="toggle-label">
        <i class="fas fa-align-justify"></i> Increase Line Height
      </span>

      <span class="toggle-switch high-contrast-border" aria-hidden="true"></span>
    </div>

    <div class="accessibility-toggle high-contrast-border"
         role="switch"
         tabindex="0"
         aria-checked="false"
         aria-label="Pause Animations - Stop all moving and blinking content"
         data-feature="pause-animations"
         data-state="off">

      <span class="toggle-label">
        <i class="fas fa-pause-circle"></i> Pause Animations
      </span>

      <span class="toggle-switch high-contrast-border" aria-hidden="true"></span>
    </div>

    <div class="accessibility-toggle high-contrast-border"
         role="switch"
         tabindex="0"
         aria-checked="false"
         aria-label="Keyboard Only Mode"
         data-feature="keyboard-only"
         data-state="off">

      <span class="toggle-label">
        <i class="fas fa-keyboard"></i> Keyboard Only Mode
      </span>

      <span class="toggle-switch high-contrast-border" aria-hidden="true"></span>
    </div>

  </div>
</div>


      <button class="accessibility-reset-btn high-contrast-border" id="resetAccessibilityBtn" aria-label="Reset All Accessibility Settings">
        <i class="fas fa-redo-alt"></i> Reset All Settings
      </button>
    </div>
  </div>
  <div class="accessibility-overlay" id="accessibilityOverlay" data-state="hidden"></div>
