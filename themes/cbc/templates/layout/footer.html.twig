<footer class="footer-modern">
<div class="footer-wrapper">
  <!-- Left Column -->
  <div class="footer-about">
    {{ page.footer_top }}
    
  </div>

  <!-- Useful Links -->
  <div class="footer-links">
    <h4>Useful Links</h4>
    
      {{ page.footer_useful_links }}
    
  </div>

  <!-- Quick Links -->
  <div class="footer-links">
    <h4>Quick Links</h4>
    
  {{ page.footer_quick_links }}
  </div>

  <!-- Contact Info -->
  <div class="footer-contact">
    <h4>Contact Us</h4>
    {{ page.contact_us }}

    <div class="visit-stats">
      <p><strong>Last Updated: </strong>{{ node.field_publication_date | date('d/m/Y') }}</p>
      <p><strong>Visitors:</strong> {{ total_visitors }}</p>
    </div>
  </div>
</div>
</footer>